@page
@inject Invoice.Code.ISelectedProfile profile
@model Invoice.Pages.InvoiceManage.ImportInvoicesModel
@{
    ViewBag.Title = "ارسال گروهی فاکتور";

}
<form method="post" asp-action="ImportInvoices" enctype="multipart/form-data">
    @if (ModelState.ErrorCount > 0)
    {
        <div class="alert alert-danger mt-3" asp-validation-summary="All"></div>
    }
    @if (User.IsInRole("reseller"))
    {
        <div class="form-group mb-3">
            <lable class="form-label">پروفایل : </lable>
            <span class="bg-white border rounded-pill p-1 pe-4 ps-4 text-secondary">@profile.Profile</span>
        </div>
    }
    <div class="form-group">
        <label class="form-label">فایل اکسل فاکتور</label>
        <div class="row">
            <div class=" col-md-10">
                <input class="form-control" asp-for="File" accept=".xls,.xlsx" required="فایل مورد نظر را مشخص کنید" />
            </div>
            <a class="col-md-2" href="/files/group-factor-template.xlsx">فایل نمونه</a>
        </div>
        <span class="text-danger" asp-validation-for="File"></span>
    </div>
    <button class="btn btn-success mt-3">بارگذاری <span class="fa fa-upload"></span></button>
</form>
<div class="table table-responsive">
    <table class="table table-hover mt-3">
        <thead>
            <tr>
                <td>ردیف</td>
                <td>نوع فاکتور</td>
                <td>الگو</td>
                <td>نوع خریدار</td>
                <td>کد اقتصادی خریدار</td>
                <td>نوع خرید</td>
                <td>مجموع فاکتور</td>
                <td></td>
            </tr>
        </thead>
        <tbody>
            @{ var index = 1;}
            @foreach (var item in Model.Invoices)
            {
                <tr>
                    <td>@(index++)</td>
                    <td>@item.Inty</td>
                    <td>@item.Inp</td>
                    <td>@item.Tob</td>
                    <td>@item.Tinb</td>
                    <td>@item.Setm</td>
                    <td>@item.Tbill</td>
                    <td>
                        <a asp-page="InvoiceConfirm" asp-route-id="@item.Id" asp-route-returnurl="/invoicemanage/importinvoices"><span class="fa fa-eye"></span></a>
                        <a asp-page-handler="delete" asp-route-id="@item.Id"><span class="fa fa-trash"></span></a>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="bottom-buttons">
    @if (Model.Invoices.Count > 0)
    {
        <a class="btn btn-success" asp-page-handler="send" onclick="return confirm('آیا مطمئنید که میخواهید همه این فاکتور ها را ارسال کنید؟')">تایید و ارسال</a>
        <a class="btn btn-danger" asp-page-handler="cancel">لغو</a>
    }
    <a class="btn btn-outline-secondary float-start" href="/index"> بازگشت <span class="fa fa-chevron-left float-start"></span></a>
</div>