                <div class="form-group mb-3">
                    <lable class="form-label">پروفایل : </lable>
                    <span class="bg-white border rounded-pill p-1 pe-4 ps-4 text-secondary">@profile.Profile</span>
                </div>
            }
            @*@if (User.IsInRole("reseller"))
        {
            <div class="mb-3 col-md-4">
                <label asp-for="Invoice.ProfileId" class="form-label"></label>
                <select asp-for="Invoice.ProfileId" class="form-control search-select" asp-items="ViewBag.ProfileId"></select>
                <span asp-validation-for="Invoice.ProfileId" class="text-danger"></span>
            </div>
        }
        else*@
