                </div>
                <div class="mb-3 col-md-2">
                    <label asp-for="Invoice.Tinb" class="form-label"></label>
                    <input asp-for="Invoice.Tinb" class="form-control" />
                    <span asp-validation-for="Invoice.Tinb" class="text-danger"></span>
                </div>
                <div class="mb-3 col-md-2">
                    <label asp-for="Invoice.Bpc" class="form-label"></label>
