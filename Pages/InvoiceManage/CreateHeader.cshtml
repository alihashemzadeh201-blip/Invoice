<div class="bottom-buttons">
    <button type="submit" class="btn btn-success">ثبت و ادامه <span class="float-end fa fa-chevron-right"></span></button>
    <a asp-page="Index" class="btn btn-outline-info float-start">بازگشت <span class="float-start fa fa-chevron-left"></a>

</div>
</form>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function syncInvoicePatternFields(selectedValue) {
            var patternValue = selectedValue ?? $('#Invoice_Inp').val();

            if (patternValue == '4') {
                $('#crn').show();
            }
            else {
                $('#crn').hide();
            }

            if (patternValue == '7') {
                $('#export-fields').show();
            }
            else {
                $('#export-fields').hide();
            }
        }

        $(document).ready(function () {
            if ($('#Invoice_Setm').val() == 3) {
                $('#cap').css({ 'display': 'block' });
            }
            else {
                $('#cap').css({ 'display': 'none' });
            }

            syncInvoicePatternFields();

            if ($('#Invoice_Nti1').val() || $('#Invoice_Nti2').val() || $('#Invoice_IsArticle9').is(':checked')) {
                $('#extra-notes-fields').show();
            }

            $('#Invoice_Inp').on('change', function () {
                syncInvoicePatternFields(this.value);
            });
        });
        function toggleExtraNotes() {
            $("#extra-notes-fields").slideToggle();
        }
        function setmChange(element) {
            if ($(element).val() == 3) {
                $("#cap").css({ 'display': 'block' });
            }
            else {
                $("#cap").css({ 'display': 'none' });
            }
        }
    </script>
}
