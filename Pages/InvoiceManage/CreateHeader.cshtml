                </div>

                <div class="mb-3 col-md-2">
                    <label asp-for="Invoice.Scln" class="form-label"></label>
                    <input asp-for="Invoice.Scln" class="form-control" />
                    <span asp-validation-for="Invoice.Scln" class="text-danger"></span>
                </div>
                <div class="mb-3 col-md-2">
                    <label asp-for="Invoice.Scc" class="form-label"></label>
                    <input asp-for="Invoice.Scc" class="form-control" />
                    <span asp-validation-for="Invoice.Scc" class="text-danger"></span>
                </div>
                <div class="mb-3 col-md-3">
                    <label asp-for="Invoice.Crn" class="form-label"></label>
                    <input asp-for="Invoice.Crn" class="form-control" />
                    <span asp-validation-for="Invoice.Crn" class="text-danger"></span>
                </div>
        </div>


    </div>*@
    @if (Model.Invoice.Ins != InvoiceTopic.ابطالی)
    {
        <div class="group mt-3">
            <div class="row mt-3">

                <div class="mb-3 col-md-2">
                    <label asp-for="Invoice.Tob" class="form-label"></label>
                    <select asp-for="Invoice.Tob" class="form-select" asp-items="Html.GetEnumSelectList<PersonType>()"><option value="" selected>--</option></select>
                    <span asp-validation-for="Invoice.Tob" class="text-danger"></span>
                </div>
                <div class="mb-3 col-md-4">
                    <label asp-for="Invoice.Bid" class="form-label"></label>
                    <input asp-for="Invoice.Bid" class="form-control" />
