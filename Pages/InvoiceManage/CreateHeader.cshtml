            <div class="mb-3 col-md-2">
                <label asp-for="Invoice.Indatim" class="form-label"></label>
                <input asp-for="Invoice.InvoiceDate" class="form-control date-picker" autocomplete="off" />
                <span asp-validation-for="Invoice.Indatim" class="text-danger"></span>
            </div>



        </div>
        <div class="row">

            @if (Model.Invoice.Ins != InvoiceTopic.ابطالی)
            {
                <div class="mb-3 col-md-2">
                    <label asp-for="Invoice.Inty" class="form-label"></label>
                    <select asp-for="Invoice.Inty" class="form-select" asp-items="Html.GetEnumSelectList<InvoiceType>()"></select>
                    <span asp-validation-for="Invoice.Inty" class="text-danger"></span>
                </div>

                <div class="mb-3 col-md-2">
                    <label asp-for="Invoice.Inp" class="form-label"></label>
                    <select asp-for="Invoice.Inp" class="form-select" asp-items="Html.GetEnumSelectList<InvoicePattern>()" onchange="syncInvoicePatternFields(this.value)"></select>
                    <span asp-validation-for="Invoice.Inp" class="text-danger"></span>
                </div>
                 <div class="mb-3 col-md-2" id="crn">
                    <label asp-for="Invoice.Crn" class="form-label"></label>
                    <input asp-for="Invoice.Crn" class="form-control" />
                    <span asp-validation-for="Invoice.Crn" class="text-danger"></span>
                </div>
                <div class="mb-3 col-md-2">
                    <label asp-for="Invoice.Setm" class="form-label"></label>
                    <select asp-for="Invoice.Setm" class="form-select" asp-items="Html.GetEnumSelectList<CheckoutType>()" onchange="setmChange(this)"></select>
                    <span asp-validation-for="Invoice.Setm" class="text-danger"></span>
                </div>
                <div class="mb-3 col-md-2" id="cap">
                    <label asp-for="Invoice.Cap" class="form-label"></label>
                    <input asp-for="Invoice.Cap" class="form-control" />
                    <span asp-validation-for="Invoice.Cap" class="text-danger"></span>
                </div>
               
                @*<div class="mb-3 col-md-2">
                        <label asp-for="Invoice.Tax17" class="form-label"></label>
                        <input asp-for="Invoice.Tax17" class="form-control" />
                        <span asp-validation-for="Invoice.Tax17" class="text-danger"></span>
                    </div>*@
            }

        </div>
        @if (Model.Invoice.Ins != InvoiceTopic.ابطالی)
        {
            <div class="row mt-3" id="export-fields">
                <div class="mb-3 col-md-2">
                    <label asp-for="Invoice.Cdcn" class="form-label"></label>
                    <input asp-for="Invoice.Cdcn" class="form-control" />
                    <span asp-validation-for="Invoice.Cdcn" class="text-danger"></span>
                </div>
                <div class="mb-3 col-md-2">
                    <label asp-for="Invoice.CdcdDate" class="form-label"></label>
                    <input asp-for="Invoice.CdcdDate" class="form-control date-picker" autocomplete="off" />
                    <span asp-validation-for="Invoice.CdcdDate" class="text-danger"></span>
                </div>
                <div class="mb-3 col-md-2">
                    <label asp-for="Invoice.Scln" class="form-label"></label>
                    <input asp-for="Invoice.Scln" class="form-control" />
                    <span asp-validation-for="Invoice.Scln" class="text-danger"></span>
                </div>
                <div class="mb-3 col-md-2">
                    <label asp-for="Invoice.Scc" class="form-label"></label>
                    <input asp-for="Invoice.Scc" class="form-control" />
                    <span asp-validation-for="Invoice.Scc" class="text-danger"></span>
                </div>
                <div class="mb-3 col-md-2">
                    <label asp-for="Invoice.Ft" class="form-label"></label>
                    <select asp-for="Invoice.Ft" class="form-select" asp-items="Html.GetEnumSelectList<FlightType>()"><option value="" selected>--</option></select>
                    <span asp-validation-for="Invoice.Ft" class="text-danger"></span>
                </div>
            </div>
        }
    </div>
    @if (Model.Invoice.Ins != InvoiceTopic.ابطالی)
    {
        <div class="group mt-3">
            <a href="#" id="toggle-extra-notes" class="text-decoration-none" onclick="toggleExtraNotes(); return false;">
                <span class="fa fa-chevron-down"></span> توضیحات تکمیلی (یادداشت‌ها / ماده ۹)
            </a>
            <div id="extra-notes-fields" class="row mt-3" style="display:none">
                <div class="mb-3 col-md-4">
                    <label asp-for="Invoice.Nti1" class="form-label"></label>
                    <input asp-for="Invoice.Nti1" class="form-control" maxlength="30" />
                    <span asp-validation-for="Invoice.Nti1" class="text-danger"></span>
                </div>
                <div class="mb-3 col-md-4">
                    <label asp-for="Invoice.Nti2" class="form-label"></label>
                    <input asp-for="Invoice.Nti2" class="form-control" maxlength="30" />
                    <span asp-validation-for="Invoice.Nti2" class="text-danger"></span>
                </div>
                <div class="mb-3 col-md-4 form-check pt-4 mt-2">
                    <input type="checkbox" class="form-check-input" asp-for="Invoice.IsArticle9" />
                    <label asp-for="Invoice.IsArticle9" class="form-check-label"></label>
                    <span asp-validation-for="Invoice.IsArticle9" class="text-danger"></span>
                </div>
            </div>
        </div>
    }
