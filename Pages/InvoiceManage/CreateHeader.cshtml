@page
@inject Invoice.Code.ISelectedProfile profile
@model Invoices.Pages.InvoiceManage.CreateModel

@{
    ViewData["Title"] = "صدور فاکتور ";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    @if (Model.Invoice?.Id > 0)
    {
        <input type="hidden" asp-for="Invoice.Id" />
    }
    <input type="hidden" asp-for="Invoice.Sender" />
    <input type="hidden" asp-for="Invoice.Ins" />
    <input type="hidden" asp-for="Invoice.Irtaxid" />
    <input type="hidden" asp-for="Invoice.Tins" />

    <div class="group">

        <div class="row">
            @if (User.IsInRole("reseller"))
