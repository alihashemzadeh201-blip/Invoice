            </div>
            <div class="mb-3 col-6">
                <label asp-for="InvoiceItem.Fee" class="form-label"></label>
                <input asp-for="InvoiceItem.Fee" class="form-control mask" ng-model="selected.fee" ng-change="updateRialValue()" />
                <span asp-validation-for="InvoiceItem.Fee" class="text-danger"></span>
            </div>
            <div class="mb-3 col-6 ">
                <label asp-for="InvoiceItem.Dis" class="form-label"></label>
                <input asp-for="InvoiceItem.Dis" class="form-control mask" ng-model="selected.dis" />
                <span asp-validation-for="InvoiceItem.Dis" class="text-danger"></span>
            </div>
            @*@if (Model.Invoice.Inp == InvoicePattern.طلا_و_جواهر)
            {
                <input type="hidden" asp-for="InvoiceItem.Vra" ng-model="selected.vra" />
            }
            else
            {*@
                <div class="mb-3">
                    <label asp-for="InvoiceItem.Vra" class="form-label"></label>
                    <select asp-for="InvoiceItem.Vra" class="form-control" asp-items="@Html.GetEnumSelectList<VatRate>()" ng-model="selected.vra"></select>
                    <span asp-validation-for="InvoiceItem.Vra" class="text-danger"></span>
                </div>
            @*}*@
        </div>

