                                {
                                    <a asp-page="InvoiceItems" asp-page-handler="Delete" asp-route-id="@item.Id" onclick="return confirm('@Messages.DeleteConfirm')" class="btn btn-sm btn-light text-danger px-2" title="حذف"><i class="fa fa-trash"></i></a>
                                }
                            </div>
                        </div>
