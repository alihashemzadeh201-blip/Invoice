    @Utils.BeginDialog("form", "افزودن قلم")
<form id="form" method="post" ng-submit="submit(this)">
    <div id="app" ng-app="app" ng-controller="controller">

        <div class="overlay" ng-show="auto_complete" ng-click="auto_complete=false"></div>

        <div ng-if="edit">
            <input type="text" class="d-none" asp-for="InvoiceItem.Id" ng-model="selected.id" value="" />
            <input type="text" class="d-none" asp-for="InvoiceItem.InvoiceId" ng-model="selected.invoiceId" value="" />
        </div>
        <input type="hidden" asp-for="InvoiceId" />
        <div class="row">
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="InvoiceItem.Sstt" class="form-label mb-0 fw-bold">
                        <i class="fas fa-star text-warning me-1"></i> شرح کالا/خدمت (انتخاب از کالاهای منتخب)
                    </label>
                    <a href="/Stuff/Index" target="_blank" class="small text-decoration-none">
                        <i class="fas fa-external-link-alt me-1"></i> مدیریت کالاهای منتخب
                    </a>
                </div>
                <div class="product-search-wrap">
                    <div class="input-group">
                        <input asp-for="InvoiceItem.Sstt" class="form-control" ng-model="selected.sstt" ng-change="sstt_change()" autocomplete="off" ng-focus="sstt_change()" onclick="this.select()" placeholder="انتخاب یا جستجو در کالاهای منتخب..." />
                        <button class="btn btn-outline-secondary" type="button" ng-click="toggle_dropdown()" title="نمایش لیست کالاهای منتخب">
                            <i class="fas" ng-class="{'fa-chevron-up': auto_complete, 'fa-chevron-down': !auto_complete}"></i>
                        </button>
                    </div>
                    <div class="auto-complete shadow-lg" ng-show="auto_complete">
                        <div class="p-2 border-bottom bg-light text-muted small d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-star text-warning me-1"></i> کالاهای منتخب شما</span>
                            <span class="badge bg-secondary-subtle text-secondary" ng-if="list.length > 0">{{list.length}} مورد</span>
                        </div>
                        <div ng-if="list.length > 0">
                            <div ng-repeat="item in list" class="auto-complete-item d-flex justify-content-between align-items-center" ng-click="item_click(item)">
                                <div class="text-truncate me-2">
                                    <div class="fw-bold text-dark">{{item.sstt}}</div>
                                    <small class="text-muted font-monospace" dir="ltr"><i class="fas fa-barcode me-1"></i>{{item.sstid}}</small>
                                </div>
                                <div class="text-end text-nowrap">
                                    <span class="badge bg-light text-dark border">مالیات: {{item.vatRatePercent}}%</span>
                                </div>
                            </div>
                        </div>
                        <div ng-if="list && list.length === 0" class="p-3 text-center text-muted small">
                            <i class="fas fa-box-open fa-2x d-block mb-2 text-secondary"></i>
                            هیچ کالایی در لیست کالاهای منتخب شما یافت نشد.
                            <div class="mt-2">
                                <a href="/Stuff/Index" target="_blank" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-plus me-1"></i> افزودن کالا به منتخب‌ها
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <span asp-validation-for="InvoiceItem.Sstt" class="text-danger small"></span>

            </div>
            <div class="mb-3">
                <label asp-for="InvoiceItem.Sstid" class="form-label"></label>
                <input asp-for="InvoiceItem.Sstid" class="form-control" ng-model="selected.sstid" />
                <span asp-validation-for="InvoiceItem.Sstid" class="text-danger"></span>
            </div>

            <div class="mb-3 col-6">
                <label asp-for="InvoiceItem.Am" class="form-label"></label>
