@section Scripts {
    @{
        Html.RenderPartial("_ValidationScriptsPartial");
    }
    <partial name="_Angular" />


    <script>
        angular.module("app", []).controller("controller", function ($http, $scope, $timeout) {
            $scope.auto_complete = false;
            $scope.selected = null;
            $scope.edit = false;
            $scope.hasCommission = false;
            $scope.updateRialValue = function () {
                if (!$scope.selected) return;

                var am = parseFloat($scope.selected.am);
                var fee = parseFloat($scope.selected.fee);

                if (isNaN(am) || isNaN(fee)) {
                    $scope.selected.ssrv = null;
                    return;
                }

                $scope.selected.ssrv = Math.round(am * fee);
            };
            $scope.setFields = function (id,invoiceId, sstt, sstid, am, mu, fee, dis, vra, consfee, spro, cut, exr, cpr, sovat, nw, ssrv, sscv, bros, bsrn) {
                $scope.selected = {
                    id: id,
                    invoiceId: invoiceId,
                    sstt: sstt,
                    sstid: sstid,
                    fee: fee,
                    mu: mu,
                    am: am,
                    dis: dis,
                    vra: vra,
                    consfee: consfee,
                    spro: spro,
                    cut: cut,
                    exr: exr,
                    cpr: cpr,
                    sovat: sovat,
                    nw: nw,
                    ssrv: ssrv,
                    sscv: sscv,
                    bros: bros,
                    bsrn: bsrn
                };
                $scope.hasCommission = !!(bros && bros != '0') || !!(bsrn && bsrn != '');
                $scope.edit = true;
                $scope.updateRialValue();
                $timeout(function () {
                    $('#InvoiceItem_Mu').trigger('change');
                    $('#InvoiceItem_Vra').trigger('change');
                    $('#InvoiceItem_Cut').trigger('change');
                }, 0, false);
            }
         
       
            $scope.toggle_dropdown = function () {
                $scope.auto_complete = !$scope.auto_complete;
                if ($scope.auto_complete) {
                    $scope.sstt_change();
                }
            };

            $scope.sstt_change = function () {
                var search = ($scope.selected && $scope.selected.sstt) ? $scope.selected.sstt : "";
                $http.get('/invoicemanage/invoiceitems?handler=getproducts&search=' + encodeURIComponent(search)).then(function (response) {
                    $scope.list = response.data || [];
                    $scope.auto_complete = true;
                });
            };
            $scope.item_click = function (item) {
                $scope.selected = item;
                $scope.updateRialValue();
                $timeout(function () {
                    $('#InvoiceItem_Mu').val($scope.selected.mu).trigger('change');
                    $('#InvoiceItem_Vra').val($scope.selected.vra).trigger('change');
                    $('#InvoiceItem_Fee').val($scope.selected.fee);
                    $('#InvoiceItem_Sstid').val($scope.selected.sstid);
                    $('#InvoiceItem_Sstt').val($scope.selected.sstt);
                    $('#InvoiceItem_Am').focus().select();
                }, 0, false);
                $scope.auto_complete = false;
            }
        });

        function setFields(id, invoiceId, sstt, sstid, am, mu, fee, dis, vra, consfee, spro, cut, exr, cpr, sovat, nw, ssrv, sscv, bros, bsrn) {
            var scope = angular.element("#app").scope();
            scope.$apply(function () {
                scope.setFields(id, invoiceId, sstt, sstid, am, mu, fee, dis, vra, consfee, spro, cut, exr, cpr, sovat, nw, ssrv, sscv, bros, bsrn);
            });
        }
        function clearFields() {
            var scope = angular.element("#app").scope();
            scope.$apply(function () {
                scope.selected = null;
                scope.edit = false;
                scope.hasCommission = false;
            });
        }
