            var index = 0;
            <div class="row">
            @foreach (var item in Model.Invoice.InvoiceItems)
            {
                index++;
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card shadow-sm h-100 border-0" style="border-radius: 12px; overflow: hidden;">
                        <div class="card-header d-flex justify-content-between align-items-center text-white" style="background: linear-gradient(45deg, #17a2b8, #138496);">
                            <span class="fw-bold text-truncate me-2" title="@item.Sstt">
                                <span class="badge bg-light text-info me-1">@index</span>
                                @item.Sstt
                            </span>
                            <div class="d-flex flex-shrink-0">
                                <a href="#" class="btn btn-sm btn-light text-primary mx-1 px-2" data-bs-target="#form" data-bs-toggle="modal" onclick="setFields('@item.Id','@item.InvoiceId','@item.Sstt','@item.Sstid','@item.Am','@item.Mu','@item.Fee','@item.Dis','@((int)item.Vra)','@item.Consfee','@item.Spro','@item.Cut','@item.Exr','@item.Cpr','@item.Sovat','@item.Nw','@item.Ssrv','@item.Sscv','@item.Bros','@item.Bsrn')" title="ویرایش"><i class="fa fa-edit"></i></a>
