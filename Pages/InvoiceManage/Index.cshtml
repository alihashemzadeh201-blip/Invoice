            <tr>
                <td></td>
                <td class="d-none d-sm-table-cell">شماره مالیاتی</td>
                <td>موضوع </td>
                <td class="d-none d-sm-table-cell">شناسه ملی خریدار</td>
                @*<td>مبلغ کل</td>
                    <td>تخفیف</td>
                    <td>مبلغ بعد از تخفیف</td>
                    <td>مبلغ ارزش افزوده</td>*@
                <td>مبلغ فاکتور</td>
                <td>وضعیت</td>
                <td></td>
            </tr>
        </thead>
        <tbody id="invoiceBody">
