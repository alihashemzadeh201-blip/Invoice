        <input type="date" id="startDate" class="form-control" placeholder="از تاریخ" />
    </div>
    <div class="col-md-3">
        <input type="date" id="endDate" class="form-control" placeholder="تا تاریخ" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100" onclick="filterByCustomDate()">اعمال</button>
    </div>
</div>
<div class="table table-responsive">
    <table class="table table-hover mt-3">
