</div>
<div id="loading" class="text-center mt-3" style="display:none">
    <span class="spinner-border"></span>
    در حال بارگذاری...
</div>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script>
        let currentPage = 1;

        let isLoading = false;
        let endOfList = false;
        $(document).ready(function () {
            $("#toggleFilter").click(function (e) {
                e.preventDefault();
                let $box = $("#filterBox");
                $box.slideToggle(300); // انیمیشن باز/بسته شدن در ۳۰۰ میلی‌ثانیه

                // چرخش آیکون فیلتر 🔽↔️
                $(this).find(".fa")
                    .toggleClass("fa-chevron-down fa-chevron-up");
            });
        });
        function loadMoreInvoices() {
               if (isLoading || endOfList) return;

               const nearBottom = window.innerHeight + window.scrollY >= document.body.offsetHeight - 100;
               if (!nearBottom) return;

               isLoading = true;
               document.getElementById('loading').style.display = 'block';
               currentPage++;
               fetch(`@Url.Page("Index", "LoadMore")&pageNumber=${currentPage}&status=@Model.Status&start=@Model.Start&end=@Model.End&buyerId=@Model.BuyerId`)
            .then(res => {
                 if (!res.ok) throw new Error("خطا در بارگذاری");
                 return res.text();
             })
            .then(html => {
                if (html.trim() === "") {
                    endOfList = true;
                    document.getElementById('loading').innerHTML = "";
                } else {
                    document.getElementById('invoiceBody').insertAdjacentHTML('beforeend', html);
                    document.getElementById('loading').style.display = 'none';
                    isLoading = false;
                }
            })
            .catch(err => {
                console.error(err);
                document.getElementById('loading').innerHTML = "<p class='text-danger'>خطا در دریافت داده‌ها</p>";
            });
           }

           window.addEventListener('scroll', loadMoreInvoices);
        function load() {
               var id = $("#ProfileId").val();
               window.location = "/InvoiceManage/Index?profileid=" + id.toString();
        }

        function checkPendingInvoices() {
            const refreshButtons = document.querySelectorAll('.auto-refresh');
            if (refreshButtons.length === 0) return;

            let needsReload = false;
            let promises = [];

            refreshButtons.forEach(btn => {
                const invoiceId = btn.getAttribute('data-id');
                
                // Show loading state on button
                btn.classList.remove('fa-refresh');
                btn.classList.add('fa-spinner', 'fa-spin');

                let p = fetch(`@Url.Page("CreateHeader", "LastStatus")&id=${invoiceId}`, {
                    headers: { 'Accept': 'application/json' }
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        needsReload = true;
                        if (data.isSuccessNow) {
                            if (Notification.permission === "granted") {
                                new Notification("فاکتور تایید شد", {
                                    body: "فاکتور با موفقیت ارسال شد و وضعیت به موفق تغییر یافت.",
                                    icon: "/favicon.ico"
                                });
                            }
                        }
                    } else {
                        // Even if it failed gracefully, maybe reload if needed? But typically success=true means it processed.
                        // If it's a JSON response, success is true.
                        needsReload = true;
                    }
                })
                .catch(err => {
                    console.error("Error refreshing status:", err);
                    btn.classList.remove('fa-spinner', 'fa-spin');
                    btn.classList.add('fa-refresh');
                });
                
                promises.push(p);
            });

            Promise.all(promises).then(() => {
                if (needsReload) {
                    window.location.reload();
                }
            });
        }

        // Check for notification permission
        if ("Notification" in window) {
            if (Notification.permission !== "granted" && Notification.permission !== "denied") {
                Notification.requestPermission();
            }
        }

        // Run auto refresh every 20 seconds
        setInterval(checkPendingInvoices, 20000);

           document.querySelector('#DateRange').addEventListener('change', function () {
            if (this.value === 'custom') {
                document.getElementById('customDateRange').style.display = 'flex';
            } else {
                document.getElementById('customDateRange').style.display = 'none';
            }
        });

        // فیلتر بر اساس بازه دلخواه
        function filterByCustomDate() {
            const start = document.getElementById('startDate').value;
            const end = document.getElementById('endDate').value;
            if (!start || !end) return alert("لطفا هر دو تاریخ را انتخاب کنید");
            window.location = `/InvoiceManage/Index?start=${start}&end=${end}`;
        }
    </script>
}
