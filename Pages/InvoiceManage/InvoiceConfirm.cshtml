<hr />
<p class="strong">اقلام فاکتور</p>
<div class="table-responsive mt-3">
    <table class="table table-hover table-striped">
        <thead>
            <tr>
                @*<td>ردیف</td>*@
                <td>شناسه کالا</td>
                <td>شرح کالا</td>
                <td>تعداد/مقدار</td>
                <td>مبلغ کل</td>

                <td class="d-none d-md-table-cell">تخفیف</td>
                <td class="d-none d-md-table-cell">ارزش افزوده</td>
                @if (Model.Invoice.Inp == InvoicePattern.طلا_و_جواهر)
                {
                    <td>اجرت و سود</td>
                }
                else if (Model.Invoice.Inp == InvoicePattern.صادرات)
                {
                    <td>ارزش ریالی</td>
                    <td>ارزش ارزی</td>
                }
                <td>مبلغ قابل پرداخت</td>
                @*<td> سهم نقدی از پرداخت</td>
                    <td> سهم مالیات بر ارزش افزوده از پرداخت</td>*@

            </tr>
        </thead>
        <tbody>
            @if (Model.Invoice == null)
            {
                <span>آیتمی وجود ندارد</span>
            }
            else
            {
                var index = 0;
                @foreach (var item in Model.Invoice.InvoiceItems)
                {
                    index++;
                    <tr>
                        @*<td>@index</td>*@
                        <td>@item.Sstid</td>
                        <td>@item.Sstt</td>
                        <td>@item.Am</td>
                        <td>@Utils.ShowCurrencyValue(item.Prdis)</td>
                        <td class="d-none d-md-table-cell">@Utils.ShowCurrencyValue(item.Dis)</td>
                        <td class="d-none d-md-table-cell">@Utils.ShowCurrencyValue(item.Vam)</td>
                        @if (Model.Invoice.Inp == InvoicePattern.طلا_و_جواهر)
                        {
                            <td>@Utils.ShowCurrencyValue(item.Tcpbs)</td>
                        }
                        else if (Model.Invoice.Inp == InvoicePattern.صادرات)
                        {
                            <td>@Utils.ShowCurrencyValue(item.Ssrv)</td>
                            <td>@Utils.ShowCurrencyValue(item.Sscv)</td>
                        }
                        <td> @Utils.ShowCurrencyValue(item.Tsstam) </td >
                        @*<td>@Utils.ShowCurrencyValue(item.Cop)</td>
                            <td>@Utils.ShowCurrencyValue(item.Vop)</td>*@
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<hr />
<p class="strong">پرداخت ها</p>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <td>شماره پیگیری/شماره مرجع</td>
                <td>شماره کارت پرداخت کننده  فاکتور</td>
                <td>تاریخ و زمان پرداخت</td>
                <td>روش پرداخت</td>
                <td>مبلغ پرداختی</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Invoice.Payments)
            {
                <tr>
                    <td>@item.Trn</td>
                    <td>@item.Pcn</td>
                    <td>@item.PayDate</td>
                    <td>@item.Pmt</td>
                    <td>@Utils.ShowCurrencyValue(item.Pv)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="mt-3">
    @{
        var status = Model.Invoice.Status.ToString().Replace("_", " ");
    }
    وضعیت :
    @switch (Model.Invoice.Status)
    {

        case InvoiceStatus.موفق:
        case InvoiceStatus.در_حال_انجام:
            <span class="badge bg-success">@status</span>
            break;
        case InvoiceStatus.پیدا_نشد:
            <span class="badge bg-danger">@status</span>
            break;
        case InvoiceStatus.در_حال_ارسال:
            <span class="badge bg-warning">@status</span>
            break;
        case InvoiceStatus.خطا_در_ارسال:
            <span class="badge bg-danger">@status</span>
            break;
        case InvoiceStatus.در_انتظار_ارسال:
            <span class="badge bg-warning">@status</span>
            break;
        case InvoiceStatus.اشکال_در_صورتحساب:
            <span class="badge bg-danger">@status</span>
            break;
        case InvoiceStatus.ابطال_شده:
            <span class="badge bg-danger">@status</span>
            break;
        case InvoiceStatus.اصلاح_شده:
            <span class="badge bg-warning">@status</span>
            break;
    }
</div>
<div class="bottom-buttons">
    @if ((Model.Invoice.Status == InvoiceStatus.خطا_در_ارسال || Model.Invoice.Status == InvoiceStatus.اشکال_در_صورتحساب || Model.Invoice.Status == InvoiceStatus.در_انتظار_ارسال) || Model.CancelInvoice == true)
    {
        if (Model.Invoice.Ins != InvoiceTopic.ابطالی && (Model.Invoice.Status == InvoiceStatus.اشکال_در_صورتحساب || Model.Invoice.Status == InvoiceStatus.خطا_در_ارسال))
        {
            <a class="btn btn-outline-danger" asp-page="CreateHeader" asp-route-id="@Model.Invoice.Id">ویرایش <span class="fa fa-edit"></span></a>
        }
        if (Model.CancelInvoice == true)
        {
            <a class="btn btn-danger" asp-page="CreateHeader" asp-page-handler="sendinvoice" asp-route-id="@Model.Invoice.Id" asp-route-cancel="true" onclick="return confirm('آیا مطمئنید که میخواهید این صورت حساب را ابطال کنید؟')">ابطال فاکتور</a>
        }
        else
        {
            <a class="btn btn-success" asp-page="CreateHeader" asp-page-handler="sendinvoice" asp-route-id="@Model.Invoice.Id" onclick="return confirm('آیا مطمئنید که میخواهید این صورت حساب را ارسال کنید؟')">ارسال  <span class="fa fa-send"></span></a>

        }
    }
    @if (Model.ReturnUrl != null)
    {
        <a class="btn btn-outline-secondary float-start" href="@Model.ReturnUrl"> بازگشت <span class="fa fa-chevron-left float-start"></span></a>
    }
    else
    {
        <a class="btn btn-outline-secondary float-start" asp-page="Payments" asp-route-invoiceid="@Model.Invoice.Id"> بازگشت <span class="fa fa-chevron-left float-start"></span></a>
    }
</div>

