@page
@model Invoice.Pages.InvoiceManage.InvoiceConfirmModel
@{
    ViewBag.Title = "مشخصات فاکتور";
    Layout = "~/Pages/Shared/_layout.cshtml";
}
@if ((Model.ExpireDate == null || Model.ExpireDate < DateTime.Now) && Model.Invoice.Ins == InvoiceTopic.اصلی && Model.CancelInvoice != true && Model.Invoice.Status != InvoiceStatus.موفق)
{
    <div class="alert alert-warning">
        کاربر گرامی! با توجه به اینکه دوره اعتباری ندارید و یا دوره شما منقضی شده ، با ارسال فاکتور در صورت ارسال موفق مبلغ @Model.PerInvoice ریال از کیف پول شما کسر خواهد شد.
    </div>
}
@if (Model.Invoice.Status == InvoiceStatus.اشکال_در_صورتحساب)
{
    var errors = Utils.GetResponseErrors(Model.Invoice.ResponseMessage);
    if (errors.Count > 0)
    {
        <div class="alert alert-danger">
            ارسال فاکتور با خطا مواجه شد. خطاهای صورت حساب:
            <ul>
                @foreach (var item in errors)
                {
                    <li>
                        <span>کد: @item.Key </span><span class="strong">پیغام: @item.Value</span>
                    </li>
                }
            </ul>
        </div>
    }
}
else if (Model.Invoice.Status == InvoiceStatus.خطا_در_ارسال)
{
    <div class="alert alert-danger">
        <span class="strong">پیغام: @Model.Invoice.ResponseMessage</span>
    </div>
}
