@page


@model Invoice.Pages.InvoiceManage.CustomerLedgerModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewBag.Title = "مدیریت مالی مشتریان";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h3>مدیریت مالی پروفایل‌ها</h3>
        <p class="text-secondary">انتخاب پروفایل و مدیریت بدهی‌ها و پرداخت‌های آن</p>
    </div>
</div>

<!-- Overall totals for accessible customers -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-light">
            <div class="card-body">
                <h6 class="card-title">کل بدهی (همه مشتریان)</h6>
                <p class="card-text fs-5">@Utils.ShowCurrencyValue(Model.OverallTotalDebt)</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-light">
            <div class="card-body">
                <h6 class="card-title">کل پرداخت (همه مشتریان)</h6>
                <p class="card-text fs-5">@Utils.ShowCurrencyValue(Model.OverallTotalPayment)</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-light">
            <div class="card-body">
                <h6 class="card-title">باقیمانده بدهی (همه مشتریان)</h6>
                <p class="card-text fs-5">@Utils.ShowCurrencyValue(Model.OverallRemainingDebt)</p>
            </div>
        </div>
    </div>
</div>

<!-- فرم جستجو -->
<form method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-5">
        <label class="form-label">جستجو</label>
        <input asp-for="SearchText" class="form-control" placeholder="" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">جستجو</button>
    </div>
</form>

<!-- لیست پروفایل‌ها -->
<div class="row" id="profile-list">
    @foreach (var profile in Model.Profiles)
    {
        <div class="col-md-6 mb-3">
            <div class="card h-100 @(profile.Id == Model.SelectedProfileId ? "border border-primary shadow-sm" : "")">
                <div class="card-body">
                    <h5 class="card-title">@profile.DisplayName</h5>
                    <p class="card-text text-secondary">@(profile.CreatorUser != null ? $"سازنده: {profile.CreatorUser.Username}" : "سازنده ثبت نشده")</p>
                    <p class="card-text">
                        <small class="text-muted">کد ملی/اقتصادی: @(string.IsNullOrWhiteSpace(profile.TinCode) ? "-" : profile.TinCode)</small>
                    </p>
                    <a href="@Url.Page("CustomerLedger", new { SelectedProfileId = profile.Id, SearchText = Model.SearchText })#selected-profile-@profile.Id" class="btn btn-sm btn-outline-primary">
                        مدیریت مالی
                    </a>

                    @* Inline details placed inside the same card so the card expands naturally *@
                    @if (Model.SelectedProfile != null && profile.Id == Model.SelectedProfileId)
                    {
                        <div class="mt-3 border-top pt-3" id="selected-profile-@profile.Id">
                            <h6 class="card-title">جزئیات مالی @Model.SelectedProfile.DisplayName</h6>
                            @if (!Model.SelectedProfileId.HasValue)
                            {
                                <div class="alert alert-warning mt-3">
                                    <i class="fas fa-exclamation-triangle"></i> پروفایلی انتخاب نشده است.
                                </div>
                            }
                            else
                            {
                                <p class="text-secondary">@($"شناسه پروفایل: {Model.SelectedProfileId}")</p>
                            }

                            @if (Model.FinancialSummary != null && Model.SelectedProfileId.HasValue)
                            {
                                <div class="row mb-4">
                                    <div class="col-md-3">
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title">کل بدهی</h6>
                                                <p class="card-text fs-5">@Utils.ShowCurrencyValue(Model.FinancialSummary.TotalDebt)</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title">کل پرداخت</h6>
                                                <p class="card-text fs-5">@Utils.ShowCurrencyValue(Model.FinancialSummary.TotalPayment)</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title">باقیمانده بدهی</h6>
                                                <p class="card-text fs-5">@Utils.ShowCurrencyValue(Model.FinancialSummary.RemainingDebt)</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (Model.SelectedProfileId.HasValue)
                            {
                                <div class="mb-4">
                                    <button class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#addPaymentModal">
                                        <i class="bi bi-plus-circle"></i> ثبت پرداخت جدید
                                    </button>
                                    <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#addDebtModal">
                                        <i class="bi bi-plus-circle"></i> ثبت بدهی جدید
                                    </button>
                                </div>

                                @if (Model.CustomerDebts.Any())
                                {
                                    <div class="mt-4">
                                        <h6>بدهی‌ها</h6>
                                        <table class="table table-striped table-hover">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>مبلغ</th>
                                                    <th>تاریخ ایجاد</th>
                                                    <th>توضیحات</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var debt in Model.CustomerDebts)
                                                {
                                                    <tr>
                                                        <td>@debt.Id</td>
                                                        <td>@Utils.ShowCurrencyValue(debt.Amount)</td>
                                                        <td>@(debt.CreatedDate != DateTime.MinValue ? MyDate.GetPersianDate(debt.CreatedDate)?.ToShortDatePersianString() ?? "-" : "-")</td>
                                                        <td>@debt.Description</td>
                                                        <td class="text-nowrap">
                                                            <button type="button" class="btn btn-sm btn-outline-primary" data-debt-edit="@debt.Id" data-debt-amount="@debt.Amount" data-debt-due="@(debt.DueDate.HasValue ? MyDate.GetPersianDate(debt.DueDate)?.ToShortDatePersianString() ?? string.Empty : string.Empty)" data-debt-desc="@debt.Description">ویرایش</button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger" data-debt-delete="@debt.Id">حذف</button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                @if (Model.CustomerPayments.Any())
                                {
                                    <div class="mt-4">
                                        <h6>پرداخت‌ها</h6>
                                        <table class="table table-striped table-hover">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>مبلغ</th>
                                                    <th>تاریخ پرداخت</th>
                                                    <th>روش پرداخت</th>
                                                    <th>شماره مرجع</th>
                                                    <th>توضیحات</th>
                                                    <th>عملیات</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var payment in Model.CustomerPayments)
                                                {
                                                    <tr>
                                                        <td>@payment.Id</td>
                                                        <td>@Utils.ShowCurrencyValue(payment.Amount)</td>
                                                        <td>@(payment.PaymentDate != DateTime.MinValue ? MyDate.GetPersianDate(payment.PaymentDate)?.ToShortDatePersianString() ?? "-" : "-")</td>
                                                        <td>@payment.PaymentMethod</td>
                                                        <td>@(payment.ReferenceNumber ?? "-")</td>
                                                        <td>@payment.Description</td>
                                                        <td class="text-nowrap">
                                                            <button type="button" class="btn btn-sm btn-outline-primary" data-payment-edit="@payment.Id" data-payment-amount="@payment.Amount" data-payment-method="@((int)payment.PaymentMethod)" data-payment-account="@payment.AccountNumber" data-payment-ref="@payment.ReferenceNumber" data-payment-desc="@payment.Description" data-payment-debtid="@payment.RelatedDebtId">ویرایش</button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger" data-payment-delete="@payment.Id">حذف</button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (!Model.Profiles.Any())
    {
        <div class="col-12">
            <div class="alert alert-info">موردی یافت نشد.</div>
        </div>
    }
</div>

<div class="text-center py-4" id="profile-scroll-sentinel">
    @if (Model.HasMoreProfiles)
    {
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">در حال بارگذاری...</span>
        </div>
    }
</div>

<script>
    (function () {
        const profileList = document.getElementById('profile-list');
        const sentinel = document.getElementById('profile-scroll-sentinel');
        let currentPage = @Model.Page;
        const pageSize = @Model.PageSize;
        let loadingProfiles = false;
        let hasMoreProfiles = @Model.HasMoreProfiles.ToString().ToLower();
        const searchText = '@(Model.SearchText?.Replace("'", "\\'") ?? "")';

        const buildProfileCard = profile => `
            <div class="col-md-6 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">${profile.displayName}</h5>
                        <p class="card-text text-secondary">سازنده: ${profile.creatorUsername}</p>
                        <p class="card-text">
                            <small class="text-muted">کد ملی/اقتصادی: ${profile.tinCode || '-'}</small>
                        </p>
                        <a href="${window.location.pathname}?SelectedProfileId=${profile.id}&SearchText=${encodeURIComponent(searchText)}#selected-profile-${profile.id}" class="btn btn-sm btn-outline-primary">
                            مدیریت مالی
                        </a>
                    </div>
                </div>
            </div>
        `;

        const loadNextProfiles = async () => {
            if (!hasMoreProfiles || loadingProfiles) return;
            loadingProfiles = true;
            currentPage += 1;
            sentinel.innerHTML = '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">در حال بارگذاری...</span></div>';
            const params = new URLSearchParams();
            params.set('handler', 'Profiles');
            params.set('page', currentPage);
            params.set('pageSize', pageSize);
            if (searchText) params.set('searchText', searchText);

            try {
                const resp = await fetch(`${window.location.pathname}?${params.toString()}`);
                if (!resp.ok) {
                    sentinel.innerHTML = '<div class="text-danger">خطا در بارگذاری</div>';
                    return;
                }
                const data = await resp.json();
                data.items.forEach(profile => profileList.insertAdjacentHTML('beforeend', buildProfileCard(profile)));
                hasMoreProfiles = data.hasMore;
                if (!hasMoreProfiles) {
                    sentinel.innerHTML = '';
                } else {
                    sentinel.innerHTML = '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">در حال بارگذاری...</span></div>';
                }
            } catch (err) {
                sentinel.innerHTML = '<div class="text-danger">خطا در بارگذاری</div>';
            } finally {
                loadingProfiles = false;
            }
        };

        const observer = new IntersectionObserver(entries => {
            if (entries.some(entry => entry.isIntersecting)) {
                loadNextProfiles();
            }
        }, { rootMargin: '200px' });

        if (sentinel) {
            observer.observe(sentinel);
        }
    })();
</script>

    <div class="modal fade" id="addPaymentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">ثبت پرداخت جدید</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="paymentForm">
                        <input type="hidden" id="paymentProfileId" value="@(Model.SelectedProfileId?.ToString() ?? string.Empty)" />
                        <input type="hidden" id="paymentId" value="0" />
                        <div class="mb-3">
                            <label class="form-label">مبلغ</label>
                            <input id="paymentAmount" type="number" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">روش پرداخت</label>
                            <select id="paymentMethod" class="form-select">
                                <option value="1">نقدی</option>
                                <option value="2">کارت اعتباری</option>
                                <option value="3">کارت به کارت</option>
                                <option value="4">چک</option>
                                <option value="5">انتقال بانکی</option>
                                <option value="6">سایر</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">شماره حساب / کارت (اختیاری)</label>
                            <input id="paymentAccount" type="text" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">شماره مرجع (اختیاری)</label>
                            <input id="paymentRef" type="text" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">توضیحات (اختیاری)</label>
                            <textarea id="paymentDesc" class="form-control"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">مرتبط با بدهی (شناسه)</label>
                            <input id="paymentDebtId" type="number" class="form-control" placeholder="در صورت مرتبط بودن، شناسه بدهی را وارد کنید" />
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
                    <button type="button" class="btn btn-primary" id="submitPaymentBtn">ثبت پرداخت</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal ثبت بدهی (kept as inner modal) -->
    <div class="modal fade" id="addDebtModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">ثبت بدهی جدید</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="debtForm">
                        <input type="hidden" id="debtProfileId" value="@(Model.SelectedProfileId?.ToString() ?? string.Empty)" />
                        <input type="hidden" id="debtId" value="0" />
                        <div class="mb-3">
                            <label class="form-label">مبلغ</label>
                            <input id="debtAmount" type="number" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">سر رسید (تاریخ شمسی، اختیاری)</label>
                            <input id="debtDueDate" type="text" class="form-control" placeholder="مثال: 1405/04/15" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">توضیحات (اختیاری)</label>
                            <textarea id="debtDesc" class="form-control"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
                    <button type="button" class="btn btn-primary" id="submitDebtBtn">ثبت بدهی</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Robust POST helper: handles empty / non-JSON responses gracefully
        async function postJson(url, payload) {
            const resp = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const text = await resp.text();
            if (!text) {
                return { success: resp.ok, message: resp.status === 204 ? 'No content' : resp.statusText };
            }

            try {
                return JSON.parse(text);
            } catch (e) {
                return { success: resp.ok, message: text };
            }
        }

        async function putJson(url, payload) {
            const resp = await fetch(url, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const text = await resp.text();
            if (!text) {
                return { success: resp.ok, message: resp.status === 204 ? 'No content' : resp.statusText };
            }

            try {
                return JSON.parse(text);
            } catch (e) {
                return { success: resp.ok, message: text };
            }
        }

        async function deleteJson(url) {
            const resp = await fetch(url, { method: 'DELETE' });
            const text = await resp.text();
            if (!text) {
                return { success: resp.ok, message: resp.status === 204 ? 'No content' : resp.statusText };
            }

            try {
                return JSON.parse(text);
            } catch (e) {
                return { success: resp.ok, message: text };
            }
        }

        function resetPaymentForm() {
            document.getElementById('paymentId').value = '0';
            document.getElementById('paymentAmount').value = '';
            document.getElementById('paymentMethod').value = '1';
            document.getElementById('paymentAccount').value = '';
            document.getElementById('paymentRef').value = '';
            document.getElementById('paymentDesc').value = '';
            document.getElementById('paymentDebtId').value = '';
            document.getElementById('submitPaymentBtn').textContent = 'ثبت پرداخت';
        }

        function resetDebtForm() {
            document.getElementById('debtId').value = '0';
            document.getElementById('debtAmount').value = '';
            document.getElementById('debtDueDate').value = '';
            document.getElementById('debtDesc').value = '';
            document.getElementById('submitDebtBtn').textContent = 'ثبت بدهی';
        }

        document.querySelectorAll('[data-payment-edit]').forEach(btn => {
            btn.addEventListener('click', function () {
                const paymentModal = new bootstrap.Modal(document.getElementById('addPaymentModal'));
                document.getElementById('paymentId').value = btn.dataset.paymentEdit || '0';
                document.getElementById('paymentAmount').value = btn.dataset.paymentAmount || '';
                document.getElementById('paymentMethod').value = btn.dataset.paymentMethod || '1';
                document.getElementById('paymentAccount').value = btn.dataset.paymentAccount || '';
                document.getElementById('paymentRef').value = btn.dataset.paymentRef || '';
                document.getElementById('paymentDesc').value = btn.dataset.paymentDesc || '';
                document.getElementById('paymentDebtId').value = btn.dataset.paymentDebtid || '';
                document.getElementById('submitPaymentBtn').textContent = 'ذخیره تغییرات';
                paymentModal.show();
            });
        });

        document.querySelectorAll('[data-payment-delete]').forEach(btn => {
            btn.addEventListener('click', async function () {
                const paymentId = btn.dataset.paymentDelete;
                if (!paymentId || !confirm('پرداخت موردنظر حذف شود؟')) {
                    return;
                }

                const res = await deleteJson(`/api/CustomerFinance/payment/${paymentId}`);
                if (res && res.success) {
                    alert(res.message || 'پرداخت حذف شد');
                    location.reload();
                } else {
                    alert(res.message || 'خطا در حذف پرداخت');
                }
            });
        });

        document.querySelectorAll('[data-debt-edit]').forEach(btn => {
            btn.addEventListener('click', function () {
                const debtModal = new bootstrap.Modal(document.getElementById('addDebtModal'));
                document.getElementById('debtId').value = btn.dataset.debtEdit || '0';
                document.getElementById('debtAmount').value = btn.dataset.debtAmount || '';
                document.getElementById('debtDueDate').value = btn.dataset.debtDue || '';
                document.getElementById('debtDesc').value = btn.dataset.debtDesc || '';
                document.getElementById('submitDebtBtn').textContent = 'ذخیره تغییرات';
                debtModal.show();
            });
        });

        document.querySelectorAll('[data-debt-delete]').forEach(btn => {
            btn.addEventListener('click', async function () {
                const debtId = btn.dataset.debtDelete;
                if (!debtId || !confirm('بدهی موردنظر حذف شود؟')) {
                    return;
                }

                const res = await deleteJson(`/api/CustomerFinance/debt/${debtId}`);
                if (res && res.success) {
                    alert(res.message || 'بدهی حذف شد');
                    location.reload();
                } else {
                    alert(res.message || 'خطا در حذف بدهی');
                }
            });
        });

        document.getElementById('submitPaymentBtn')?.addEventListener('click', async function () {
            const paymentId = parseInt(document.getElementById('paymentId').value || '0', 10);
            const profileId = parseInt(document.getElementById('paymentProfileId').value || '0', 10);
            const amount = parseInt(document.getElementById('paymentAmount').value || 0, 10);
            const method = parseInt(document.getElementById('paymentMethod').value || 1, 10);
            const account = document.getElementById('paymentAccount').value;
            const reference = document.getElementById('paymentRef').value;
            const desc = document.getElementById('paymentDesc').value;
            const debtIdVal = document.getElementById('paymentDebtId').value;
            const payload = {
                ProfileId: profileId,
                Amount: amount,
                PaymentMethod: method,
                AccountNumber: account || null,
                ReferenceNumber: reference || null,
                Description: desc || null,
                RelatedDebtId: debtIdVal ? parseInt(debtIdVal, 10) : null
            };

            if (!profileId || profileId <= 0) {
                alert('شناسه پروفایل نامشخص است. ابتدا یک پروفایل انتخاب کنید.');
                return;
            }
            if (!amount || amount <= 0) {
                alert('مبلغ باید بزرگتر از صفر باشد.');
                return;
            }

            try {
                const res = paymentId > 0
                    ? await putJson(`/api/CustomerFinance/payment/${paymentId}`, payload)
                    : await postJson('/api/CustomerFinance/payment', payload);

                if (res && res.success) {
                    alert(res.message || (paymentId > 0 ? 'پرداخت ویرایش شد' : 'پرداخت ثبت شد'));
                    resetPaymentForm();
                    location.reload();
                } else {
                    alert(res.message || ('خطا در ثبت پرداخت (جزئیات): ' + JSON.stringify(res)));
                }
            } catch (e) {
                alert('خطا: ' + e.message);
            }
        });

        document.getElementById('submitDebtBtn')?.addEventListener('click', async function () {
            const debtId = parseInt(document.getElementById('debtId').value || '0', 10);
            const profileId = parseInt(document.getElementById('debtProfileId').value || '0', 10);
            const amount = parseInt(document.getElementById('debtAmount').value || 0, 10);
            const due = document.getElementById('debtDueDate').value || null;
            const desc = document.getElementById('debtDesc').value || null;
            const payload = {
                ProfileId: profileId,
                Amount: amount,
                DueDatePersian: due,
                Description: desc
            };

            if (!profileId || profileId <= 0) {
                alert('شناسه پروفایل نامشخص است. ابتدا یک پروفایل انتخاب کنید.');
                return;
            }
            if (!amount || amount <= 0) {
                alert('مبلغ باید بزرگتر از صفر باشد.');
                return;
            }

            try {
                const res = debtId > 0
                    ? await putJson(`/api/CustomerFinance/debt/${debtId}`, payload)
                    : await postJson('/api/CustomerFinance/debt', payload);

                if (res && res.success) {
                    alert(res.message || (debtId > 0 ? 'بدهی ویرایش شد' : 'بدهی ثبت شد'));
                    resetDebtForm();
                    location.reload();
                } else {
                    alert(res.message || ('خطا در ثبت بدهی (جزئیات): ' + JSON.stringify(res)));
                }
            } catch (e) {
                alert('خطا: ' + e.message);
            }
        });

        document.getElementById('addPaymentModal')?.addEventListener('hidden.bs.modal', function () {
            resetPaymentForm();
        });

