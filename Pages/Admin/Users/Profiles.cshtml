@page
@model Invoice.Pages.Admin.Users.ProfileModel
@{
    ViewBag.Title = "مدیریت پروفایل";
    Layout = "~/Pages/Shared/_layout.cshtml";

}
@if (Model.MaxProfileCount==null || Model.Profiles.Count < Model.MaxProfileCount)
{
    <a class="btn btn-info" asp-page="AddProfile">پروفایل جدید</a>
}
<form method="post">
    <div class="input-group mt-3">
        <input type="text" class="form-control" asp-for="Search" />
        <button class="input-group-text"><i class="fa fa-search"></i></button>
    </div>
</form>
<div class="mt-3 table-responsive">
<table class="table table-hover table-striped">
    <thead>
        <tr>
            <td>نام</td>
            <td>نام خانوادگی</td>
            <td>شماره اقتصادی</td>
            @if (User.IsInRole("admin"))
            {
                <td>ایجاد کننده اکانت</td>
            }
            <td></td>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Profiles)
        {
            <tr>
                <td>@item.FirstName</td>
                <td>@item.Lastname</td>
                <td>@item.TinCode</td>
                @if (User.IsInRole("admin"))
                {
                    <td>@item.CreatorUser?.DisplayName</td>
                }
                <td>
                    <a asp-page="AddProfile" asp-route-id="@item.Id"><span class="fa fa-edit"></span></a>
                    <a asp-page-handler="Delete" asp-route-id="@item.Id" onclick="return confirm('@Messages.DeleteConfirm')"><span class="fa fa-remove"></span></a>
                </td>
            </tr>
        }
    </tbody>

</table>
</div>