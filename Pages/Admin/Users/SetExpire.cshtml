@page
@model Invoice.Pages.Admin.Users.SetExpireModel
@{
    ViewBag.Title = "تمدید اعتبار";
    Layout = "~/Pages/Shared/_layout.cshtml";
}

<form method="post">
    <input type="hidden" asp-for="Username"/>
    <div class="row">
        <div class="form-group">
            <label class="form-label">کاربر</label>
            <div class="text-info">@Model.UserDisplay</div>
        </div>
    </div>
    <div class="row">
        <div class="form-group col-md-3">
            <label class="form-label" asp-for="Months"></label>
            <input class="form-control " asp-for="Months"/>
            <span class="text-danger" asp-for="Months"></span>
        </div>
    </div>
    <button class="mt-3 btn btn-success">ثبت</button>
</form>
