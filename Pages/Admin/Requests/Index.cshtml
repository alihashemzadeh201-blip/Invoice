@page
@model Invoice.Pages_Admin_KarpooshehRequest.IndexModel

@{
    ViewBag.Title = "لیست درخواست ها";
}

<table class="table table-hover">
    <thead>
        <tr>
            <th class="d-none d-md-table-cell">
                @Html.DisplayNameFor(model => model.KarpooshehRequest[0].NationalId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KarpooshehRequest[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KarpooshehRequest[0].Phone)
            </th>
            <th class="d-none d-md-table-cell">
                @Html.DisplayNameFor(model => model.KarpooshehRequest[0].Email)
            </th>
            <th class="d-none d-md-table-cell">
                @Html.DisplayNameFor(model => model.KarpooshehRequest[0].JobTitle)
            </th>
            <th class="d-none d-md-table-cell">
                @Html.DisplayNameFor(model => model.KarpooshehRequest[0].Description)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.KarpooshehRequest)
        {
        <tr>
                <td class="d-none d-md-table-cell">
                @Html.DisplayFor(modelItem => item.NationalId)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.Name)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
            <td class="d-none d-md-table-cell">
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td class="d-none d-md-table-cell">
                @Html.DisplayFor(modelItem => item.JobTitle)
            </td>
            <td class="d-none d-md-table-cell">
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                <a asp-page-handler="Receive" asp-route-id="@item.Id">دریافت</a> 
                <a asp-page="./Details" asp-route-id="@item.Id"><span class="fa fa-eye"></span></a> 
                <a asp-page-handler="Reject" asp-route-id="@item.Id" onclick="return confirm('@Messages.DeleteConfirm')"><span class="fa fa-remove text-danger"></span></a>
            </td>
        </tr>
}
        </table>
  