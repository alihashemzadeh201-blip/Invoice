@page
@model Invoice.Pages_Admin_KarpooshehRequest.IndexModel

@{
    ViewBag.Title = "لیست درخواست‌های کارپوشه";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0 text-primary">
            <i class="fas fa-folder-open me-2"></i> لیست درخواست‌های کارپوشه (شناسه یکتای حافظه مالیاتی)
        </h4>
        @if (Model.KarpooshehRequest != null && Model.KarpooshehRequest.Any())
        {
            <span class="badge bg-primary fs-6">
                @Model.KarpooshehRequest.Count درخواست فعال
            </span>
        }
    </div>

    @if (Model.KarpooshehRequest == null || !Model.KarpooshehRequest.Any())
    {
        <div class="alert alert-info border-0 shadow-sm mt-3">
            <i class="fas fa-info-circle me-2"></i> در حال حاضر هیچ درخواست کارپوشه در انتظار بررسی وجود ندارد.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-nowrap">
                                <i class="fas fa-calendar-alt me-1 text-muted"></i> تاریخ درخواست
                            </th>
                            <th class="d-none d-md-table-cell text-nowrap">
                                کد ملی
                            </th>
                            <th>
                                نام و نام خانوادگی
                            </th>
                            <th class="text-nowrap">
                                شماره تماس
                            </th>
                            <th class="d-none d-lg-table-cell">
                                شغل
                            </th>
                            <th class="d-none d-xl-table-cell">
                                ایمیل
                            </th>
                            <th class="d-none d-md-table-cell">
                                توضیحات
                            </th>
                            <th class="text-nowrap">
                                وضعیت پرداخت
                            </th>
                            <th class="text-center text-nowrap">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.KarpooshehRequest)
                        {
                            <tr>
                                <td class="text-nowrap fw-bold text-secondary">
                                    @(item.RequestDate != default ? (MyDate.GetPersianDate(item.RequestDate)?.ToString() ?? "-") : "-")
                                </td>
                                <td class="d-none d-md-table-cell text-nowrap">
                                    @Html.DisplayFor(modelItem => item.NationalId)
                                </td>
                                <td class="fw-bold">
                                    @Html.DisplayFor(modelItem => item.Name)
                                </td>
                                <td class="text-nowrap" dir="ltr">
                                    @Html.DisplayFor(modelItem => item.Phone)
                                </td>
                                <td class="d-none d-lg-table-cell">
                                    @Html.DisplayFor(modelItem => item.JobTitle)
                                </td>
                                <td class="d-none d-xl-table-cell">
                                    @Html.DisplayFor(modelItem => item.Email)
                                </td>
                                <td class="d-none d-md-table-cell small text-muted">
                                    @Html.DisplayFor(modelItem => item.Description)
                                </td>
                                <td class="text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(item.BaleChatId))
                                    {
                                        <span class="badge bg-primary me-1" title="ثبت شده از طریق ربات بله"><i class="fas fa-robot"></i> بله</span>
                                        @if (item.IsPaid)
                                        {
                                            <span class="badge bg-success" title="کد رهگیری: @item.PaymentReference">
                                                <i class="fas fa-check-circle"></i> پرداخت شده
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="fas fa-clock"></i> در انتظار پرداخت
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="fas fa-globe"></i> وب‌سایت</span>
                                    }
                                </td>
                                <td class="text-center text-nowrap">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-primary" title="مشاهده جزئیات و صدور شناسه">
                                            <i class="fas fa-key me-1"></i> صدور شناسه
                                        </a>
                                        @if (item.ReceiveDate == null)
                                        {
                                            <a asp-page-handler="Receive" asp-route-id="@item.Id" class="btn btn-outline-success" title="ثبت دریافت درخواست">
                                                <i class="fas fa-check"></i>
                                            </a>
                                        }
                                        <a asp-page-handler="Reject" asp-route-id="@item.Id" onclick="return confirm('@Messages.DeleteConfirm')" class="btn btn-outline-danger" title="حذف درخواست">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
