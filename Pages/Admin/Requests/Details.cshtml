@page "{id:int}"
@model Invoice.Pages_Admin_KarpooshehRequest.DetailsModel

@{
    ViewBag.Title = "مشخصات و تکمیل درخواست کارپوشه";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0 text-primary">
            <i class="fas fa-file-alt me-2"></i> مشخصات و تکمیل درخواست کارپوشه (شناسه یکتا)
        </h4>
        <a asp-page="./Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-right me-1"></i> بازگشت به لیست درخواست‌ها
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-3" role="alert">
            <i class="fas fa-check-circle me-2"></i> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0 text-secondary">
                        <i class="fas fa-id-card me-2"></i> اطلاعات هویتی و ثبت‌نام متقاضی
                    </h5>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">
                            <i class="fas fa-calendar-alt me-1 text-primary"></i> تاریخ ثبت (شمسی):
                        </dt>
                        <dd class="col-sm-8 fw-bold text-primary">
                            @(Model.KarpooshehRequest.RequestDate != default ? (MyDate.GetPersianDate(Model.KarpooshehRequest.RequestDate)?.ToString() ?? "-") : "-")
                        </dd>

                        @if (Model.KarpooshehRequest.ReceiveDate != null)
                        {
                            <dt class="col-sm-4 text-muted">
                                <i class="fas fa-calendar-check me-1 text-success"></i> تاریخ بررسی و دریافت:
                            </dt>
                            <dd class="col-sm-8 text-success fw-bold">
                                @(MyDate.GetPersianDate(Model.KarpooshehRequest.ReceiveDate)?.ToString() ?? "-")
                            </dd>
                        }

                        <dt class="col-sm-4 text-muted">
                            @Html.DisplayNameFor(model => model.KarpooshehRequest.Name):
                        </dt>
                        <dd class="col-sm-8 fw-bold">
                            @Html.DisplayFor(model => model.KarpooshehRequest.Name)
                        </dd>

                        <dt class="col-sm-4 text-muted">
                            نام عمومی (لاتین):
                        </dt>
                        <dd class="col-sm-8 font-monospace">
                            @(string.IsNullOrEmpty(Model.KarpooshehRequest.LatinName) ? "-" : Model.KarpooshehRequest.LatinName)
                        </dd>

                        <dt class="col-sm-4 text-muted">
                            @Html.DisplayNameFor(model => model.KarpooshehRequest.NationalId):
                        </dt>
                        <dd class="col-sm-8 fw-bold font-monospace">
                            @Html.DisplayFor(model => model.KarpooshehRequest.NationalId)
                        </dd>

                        <dt class="col-sm-4 text-muted">
                            @Html.DisplayNameFor(model => model.KarpooshehRequest.PersonType):
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.KarpooshehRequest.PersonType == PersonType.حقوقی ? "bg-info text-dark" : "bg-secondary")">
                                @Model.KarpooshehRequest.PersonType
                            </span>
                        </dd>

                        <dt class="col-sm-4 text-muted">
                            @Html.DisplayNameFor(model => model.KarpooshehRequest.Phone):
                        </dt>
                        <dd class="col-sm-8" dir="ltr">
                            <a href="tel:@Model.KarpooshehRequest.Phone" class="text-decoration-none">
                                @Model.KarpooshehRequest.Phone
                            </a>
                        </dd>

                        <dt class="col-sm-4 text-muted">
                            @Html.DisplayNameFor(model => model.KarpooshehRequest.JobTitle):
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.KarpooshehRequest.JobTitle)
                        </dd>

                        <dt class="col-sm-4 text-muted">
                            کد پستی ۱۰ رقمی:
                        </dt>
                        <dd class="col-sm-8 font-monospace">
                            @(string.IsNullOrEmpty(Model.KarpooshehRequest.PostalCode) ? "-" : Model.KarpooshehRequest.PostalCode)
                        </dd>

                        <dt class="col-sm-4 text-muted">
                            @Html.DisplayNameFor(model => model.KarpooshehRequest.Email):
                        </dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrEmpty(Model.KarpooshehRequest.Email) ? "-" : Model.KarpooshehRequest.Email)
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.KarpooshehRequest.TaxPassword))
                        {
                            <dt class="col-sm-4 text-muted">
                                رمز عبور سامانه مودیان:
                            </dt>
                            <dd class="col-sm-8 font-monospace">
                                @Model.KarpooshehRequest.TaxPassword
                            </dd>
                        }

                        <dt class="col-sm-4 text-muted">
                            @Html.DisplayNameFor(model => model.KarpooshehRequest.Description):
                        </dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrEmpty(Model.KarpooshehRequest.Description) ? "-" : Model.KarpooshehRequest.Description)
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <!-- وضعیت اتصال پیام‌رسان بله و پرداخت -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0 text-secondary">
                        <i class="fab fa-telegram me-2 text-primary"></i> وضعیت اتصال پیام‌رسان بله و پرداخت
                    </h5>
                </div>
                <div class="card-body p-3">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">مبدا درخواست:</span>
                            @if (!string.IsNullOrWhiteSpace(Model.KarpooshehRequest.BaleChatId))
                            {
                                <span class="badge bg-primary">
                                    <i class="fas fa-robot me-1"></i> ربات کاربر بله
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="fas fa-globe me-1"></i> فرم وب‌سایت
                                </span>
                            }
                        </li>
                        @if (!string.IsNullOrWhiteSpace(Model.KarpooshehRequest.BaleChatId))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted">شناسه چت بله (ChatId):</span>
                                <code class="text-dark">@Model.KarpooshehRequest.BaleChatId</code>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted">نام کاربری بله:</span>
                                <span>@(string.IsNullOrWhiteSpace(Model.KarpooshehRequest.BaleUsername) ? "-" : "@" + Model.KarpooshehRequest.BaleUsername)</span>
                            </li>
                        }
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">وضعیت پرداخت بله:</span>
                            @if (Model.KarpooshehRequest.IsPaid)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle me-1"></i> پرداخت شده
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="fas fa-clock me-1"></i> در انتظار پرداخت
                                </span>
                            }
                        </li>
                        @if (Model.KarpooshehRequest.IsPaid)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted">مبلغ پرداختی:</span>
                                <span class="fw-bold text-success">@(Model.KarpooshehRequest.PaymentAmount?.ToString("N0") ?? "-") ریال</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted">کد پیگیری پرداخت بله:</span>
                                <code class="text-dark small">@Model.KarpooshehRequest.PaymentReference</code>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <!-- فرم تکمیل فرآیند و صدور شناسه یکتا -->
            <div class="card shadow-sm border-0 border-top border-primary border-3">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0 text-primary">
                        <i class="fas fa-key me-2"></i> تکمیل فرآیند و صدور شناسه یکتا
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.KarpooshehRequest.FinishDate != null)
                    {
                        <div class="alert alert-success border-0 mb-0">
                            <h6 class="alert-heading fw-bold">
                                <i class="fas fa-check-double me-2"></i> پرونده تکمیل گردیده است
                            </h6>
                            <p class="mb-0 small">
                                این پرونده در تاریخ @(MyDate.GetPersianDate(Model.KarpooshehRequest.FinishDate.Value)?.ToString() ?? "-") با موفقیت تکمیل شده است.
                            </p>
                        </div>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Complete" asp-route-id="@Model.KarpooshehRequest.Id">
                            <div class="mb-3">
                                <label asp-for="MemoryId" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-fingerprint"></i></span>
                                    <input asp-for="MemoryId" class="form-control font-monospace text-uppercase" placeholder="مثال: A1B2C3" maxlength="6" required dir="ltr" />
                                </div>
                                <div class="form-text small">شناسه یکتای حافظه مالیاتی اخذ شده از کارپوشه (۶ کاراکتر).</div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UserPassword" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                    <input asp-for="UserPassword" class="form-control font-monospace" placeholder="در صورت خالی بودن شماره همراه قرار می‌گیرد" dir="ltr" />
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.KarpooshehRequest.BaleChatId))
                            {
                                <div class="form-check form-switch mb-3">
                                    <input asp-for="NotifyOnBale" class="form-check-input" type="checkbox" id="notifyBaleCheck" />
                                    <label class="form-check-label fw-bold" for="notifyBaleCheck">
                                        ارسال خودکار پیام تبریک و مشخصات در ربات بله
                                    </label>
                                </div>
                            }

                            <div class="d-grid">
                                <button type="submit" class="btn btn-success btn-lg" onclick="return confirm('آیا از صدور شناسه یکتا و فعال‌سازی حساب مودی اطمینان دارید؟');">
                                    <i class="fas fa-check-circle me-1"></i> تکمیل درخواست و ثبت شناسه یکتا
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
