@page
@model Invoice.Pages_Admin_KarpooshehRequest.DetailsModel

@{
    ViewBag.Title = "مشخصات درخواست کارپوشه";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0 text-primary">
            <i class="fas fa-file-alt me-2"></i> مشخصات درخواست کارپوشه (شناسه یکتا)
        </h4>
        <a asp-page="./Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-right me-1"></i> بازگشت به لیست درخواست‌ها
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">
                    <i class="fas fa-calendar-alt me-1 text-primary"></i> تاریخ ثبت درخواست (شمسی):
                </dt>
                <dd class="col-sm-9 fw-bold text-primary">
                    @(Model.KarpooshehRequest.RequestDate != default ? (MyDate.GetPersianDate(Model.KarpooshehRequest.RequestDate)?.ToString() ?? "-") : "-")
                </dd>

                @if (Model.KarpooshehRequest.ReceiveDate != null)
                {
                    <dt class="col-sm-3 text-muted">
                        <i class="fas fa-calendar-check me-1 text-success"></i> تاریخ دریافت:
                    </dt>
                    <dd class="col-sm-9 text-success fw-bold">
                        @(MyDate.GetPersianDate(Model.KarpooshehRequest.ReceiveDate)?.ToString() ?? "-")
                    </dd>
                }

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.KarpooshehRequest.NationalId):
                </dt>
                <dd class="col-sm-9 fw-bold">
                    @Html.DisplayFor(model => model.KarpooshehRequest.NationalId)
                </dd>

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.KarpooshehRequest.Name):
                </dt>
                <dd class="col-sm-9 fw-bold">
                    @Html.DisplayFor(model => model.KarpooshehRequest.Name)
                </dd>

                <dt class="col-sm-3 text-muted">
                    نام عمومی (انگلیسی):
                </dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrEmpty(Model.KarpooshehRequest.LatinName) ? "-" : Model.KarpooshehRequest.LatinName)
                </dd>

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.KarpooshehRequest.Phone):
                </dt>
                <dd class="col-sm-9" dir="ltr">
                    @Html.DisplayFor(model => model.KarpooshehRequest.Phone)
                </dd>

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.KarpooshehRequest.Email):
                </dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrEmpty(Model.KarpooshehRequest.Email) ? "-" : Model.KarpooshehRequest.Email)
                </dd>

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.KarpooshehRequest.PersonType):
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.KarpooshehRequest.PersonType)
                </dd>

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.KarpooshehRequest.JobTitle):
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.KarpooshehRequest.JobTitle)
                </dd>

                @if (!string.IsNullOrEmpty(Model.KarpooshehRequest.TaxPassword))
                {
                    <dt class="col-sm-3 text-muted">
                        رمز عبور سامانه مودیان:
                    </dt>
                    <dd class="col-sm-9 font-monospace">
                        @Model.KarpooshehRequest.TaxPassword
                    </dd>
                }

                <dt class="col-sm-3 text-muted">
                    @Html.DisplayNameFor(model => model.KarpooshehRequest.Description):
                </dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrEmpty(Model.KarpooshehRequest.Description) ? "-" : Model.KarpooshehRequest.Description)
                </dd>
            </dl>
        </div>
        <div class="card-footer bg-white border-top py-3">
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-right me-1"></i> بازگشت به لیست درخواست‌ها
            </a>
        </div>
    </div>
</div>
