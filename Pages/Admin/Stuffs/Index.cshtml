@page
@model Invoice.Pages.Admin.Stuffs.IndexModel
@{
    ViewBag.Title = "مدیریت و بارگذاری شناسه‌های کالا و خدمات (اکسل)";
    Layout = "~/Pages/Shared/_layout.cshtml";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h4 class="mb-1 text-primary">
                <i class="fas fa-barcode me-2"></i> بانک شناسه‌های کالا و خدمات سامانه مودیان
            </h4>
            <span class="text-muted small">
                تعداد کل شناسه‌های ثبت‌شده در سامانه: <strong>@Model.TotalCount.ToString("N0") مورد</strong>
            </span>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="./Import" class="btn btn-success">
                <i class="fas fa-file-excel me-1"></i> بارگذاری انبوه از اکسل
            </a>
            <a asp-page-handler="DownloadTemplate" class="btn btn-outline-secondary">
                <i class="fas fa-download me-1"></i> دانلود قالب نمونه اکسل
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-3" role="alert">
            <i class="fas fa-check-circle me-2"></i> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-9">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" asp-for="Search" placeholder="جستجو بر اساس شناسه کالا (۱۳ رقم) یا شرح کالا/خدمت..." />
                    </div>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="fas fa-search me-1"></i> جستجو
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <a asp-page="./Index" class="btn btn-outline-secondary">پاک کردن</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th style="width: 200px;">شناسه کالا/خدمت</th>
                            <th>شرح کالا/خدمت</th>
                            <th style="width: 130px;" class="text-center">نرخ مالیات (٪)</th>
                            <th style="width: 140px;" class="text-center">نوع شناسه</th>
                            <th style="width: 110px;" class="text-center">مشمولیت</th>
                            <th style="width: 80px;" class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Stuffs.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fas fa-inbox fa-3x mb-3 text-secondary d-block"></i>
                                    هیچ موردی یافت نشد. می‌توانید با استفاده از دکمه «بارگذاری انبوه از اکسل»، فایل شناسه‌های سازمان امور مالیاتی را بارگذاری نمایید.
                                </td>
                            </tr>
                        }
                        else
                        {
                            var rowIndex = (Model.PageNumber - 1) * Model.PageSize + 1;
                            @foreach (var item in Model.Stuffs)
                            {
                                <tr>
                                    <td class="text-muted small">@rowIndex</td>
                                    <td>
                                        <code class="fw-bold text-dark font-monospace" dir="ltr">@item.Code</code>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@item.Title</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@item.VatRate %</span>
                                    </td>
                                    <td class="text-center small text-muted">
                                        @item.Type.ToString().Replace("_", " ")
                                    </td>
                                    <td class="text-center">
                                        @if (item.VatTax)
                                        {
                                            <span class="badge bg-success-subtle text-success">مشمول</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">معاف</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <form method="post" asp-page-handler="Delete" asp-route-code="@item.Code" onsubmit="return confirm('آیا از حذف این شناسه کالا اطمینان دارید؟');" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger btn-sm p-1 px-2" title="حذف">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                <span class="text-muted small">
                    صفحه @Model.PageNumber از @Model.TotalPages (نمایش @Model.Stuffs.Count مورد از @Model.TotalCount.ToString("N0"))
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @if (Model.PageNumber > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Index" asp-route-Search="@Model.Search" asp-route-PageNumber="@(Model.PageNumber - 1)">قبلی</a>
                            </li>
                        }

                        @{
                            var startPage = Math.Max(1, Model.PageNumber - 2);
                            var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                        }

                        @for (var p = startPage; p <= endPage; p++)
                        {
                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-page="./Index" asp-route-Search="@Model.Search" asp-route-PageNumber="@p">@p</a>
                            </li>
                        }

                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Index" asp-route-Search="@Model.Search" asp-route-PageNumber="@(Model.PageNumber + 1)">بعدی</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
