@page
@model Invoice.Pages.Admin.Bale.SendMessageModel
@{
    ViewBag.Title = "ارسال پیام به کاربران بله";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 text-primary">
                <i class="fas fa-bullhorn me-2 text-warning"></i> ارسال پیام به کاربران پیام‌رسان بله
            </h4>
            <p class="text-muted small mb-0">انتخاب کاربران دارای شناسه چت بله و ارسال پیام‌های اطلاع‌رسانی، اطلاعیه یا پیام اختصاصی</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Admin/Bale/Index" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-cog me-1"></i> تنظیمات بله
            </a>
            <a asp-page="/Admin/Users/Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-right me-1"></i> بازگشت
            </a>
        </div>
    </div>

    @if (!Model.IsUserBotConfigured)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="fas fa-exclamation-triangle fa-2x me-3 text-warning"></i>
            <div>
                <strong>هشدار: توکن ربات کاربر (User Bot Token) تنظیم نشده است!</strong>
                <p class="mb-0 small">جهت ارسال پیام به کاربران، ابتدا باید در صفحه <a asp-page="/Admin/Bale/Index" class="fw-bold">تنظیمات بله</a> توکن ربات کاربر را وارد و فعال نمایید.</p>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>خطا:</strong> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }

    <form method="post" id="broadcastForm">
        <div class="row g-4 mb-4">
            <!-- ستون متن پیام و دکمه‌های ارسال -->
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                    <div class="card-header bg-primary text-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h6 class="card-title mb-0">
                            <i class="fas fa-edit me-2"></i> متن پیام ارسالی
                        </h6>
                        <span class="badge bg-light text-primary" id="selectedCounterBadge">
                            ۰ کاربر انتخاب شده
                        </span>
                    </div>
                    <div class="card-body p-3">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">متن پیام:</label>
                            <textarea class="form-control" asp-for="MessageText" id="messageTextInput" rows="7" placeholder="متن پیام خود را اینجا وارد نمایید...&#10;&#10;راهنما: می‌توانید از *متن بولد* و `کد` و _ایتالیک_ استفاده کنید." required></textarea>
                            <small class="text-muted d-block mt-1">
                                <i class="fas fa-info-circle me-1"></i> تگ‌های قالب‌بندی خودکار به مارک‌داون استاندارد بله تبدیل می‌شوند.
                            </small>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" asp-page-handler="SendSelected" id="sendSelectedBtn" class="btn btn-primary py-2 fw-bold" onclick="return confirmSendSelected();">
                                <i class="fas fa-paper-plane me-1"></i> ارسال به کاربران انتخاب‌شده (<span id="btnSelectedCount">۰</span>)
                            </button>
                            <button type="submit" asp-page-handler="SendToAll" class="btn btn-outline-warning text-dark py-2 fw-bold" onclick="return confirm('آیا از ارسال این پیام به تمام مخاطبان بله اطمینان دارید؟');">
                                <i class="fas fa-broadcast-tower me-1"></i> ارسال همگانی به همه (@Model.Users.Count نفر)
                            </button>
                        </div>

                        <hr class="my-3 text-muted" />

                        <!-- ارسال تکی به یک چت‌آیدی خاص -->
                        <div>
                            <label class="form-label small fw-bold text-secondary">
                                <i class="fas fa-user me-1"></i> یا ارسال اختصاصی به یک شناسه چت:
                            </label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control font-monospace" dir="ltr" asp-for="DirectChatId" id="directChatIdInput" placeholder="شناسه چت مقصد..." />
                                <button type="submit" asp-page-handler="SendDirect" class="btn btn-outline-secondary" onclick="return confirmDirectSend();">
                                    <i class="fas fa-paper-plane me-1"></i> ارسال تکی
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ستون لیست کاربران دارای ChatId -->
            <div class="col-lg-7">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-0">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h6 class="card-title mb-0 text-dark fw-bold">
                                    <i class="fas fa-users me-2 text-primary"></i> لیست کاربران دارای شناسه چت بله
                                </h6>
                                <small class="text-muted">مجموعاً @Model.Users.Count کاربر شناسایی شده</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" id="selectAllBtn" onclick="toggleAllCheckboxes(true)">
                                    <i class="fas fa-check-square me-1"></i> انتخاب همه
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="deselectAllBtn" onclick="toggleAllCheckboxes(false)">
                                    <i class="fas fa-square me-1"></i> لغو همه
                                </button>
                            </div>
                        </div>

                        <!-- فیلتر و جستجوی لحظه‌ای -->
                        <div class="row g-2 mt-2">
                            <div class="col-md-7">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                                    <input type="text" id="userSearchInput" class="form-control" placeholder="جستجو بر اساس نام، شماره همراه، کد ملی یا شناسه چت..." onkeyup="filterUserTable()" />
                                </div>
                            </div>
                            <div class="col-md-5">
                                <select id="sourceFilterSelect" class="form-select form-select-sm" onchange="filterUserTable()">
                                    <option value="">همه منابع کاربران</option>
                                    <option value="کاربر سامانه">کاربر سامانه</option>
                                    <option value="متقاضی کارپوشه">متقاضی کارپوشه</option>
                                    <option value="کاربر ربات">کاربر ربات</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0 small" id="usersTable">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th style="width: 40px;" class="text-center">
                                        <input class="form-check-input" type="checkbox" id="masterCheckbox" onchange="toggleMaster(this)">
                                    </th>
                                    <th>نام / عنوان</th>
                                    <th>شماره تماس</th>
                                    <th>کد ملی / شناسه</th>
                                    <th>شناسه چت (Chat ID)</th>
                                    <th>منبع</th>
                                    <th class="text-center">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Users.Count == 0)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            <i class="fas fa-info-circle me-1"></i> هنوز هیچ کاربر یا شناسه چت بله‌ای در سامانه ذخیره نشده است.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @for (var i = 0; i < Model.Users.Count; i++)
                                    {
                                        var u = Model.Users[i];
                                        <tr class="user-row" data-source="@u.Source">
                                            <td class="text-center">
                                                <input class="form-check-input user-check" type="checkbox" name="SelectedChatIds" value="@u.ChatId" onchange="updateSelectedCount()" />
                                            </td>
                                            <td>
                                                <div class="fw-bold">@u.DisplayName</div>
                                                @if (!string.IsNullOrWhiteSpace(u.BaleUsername))
                                                {
                                                    <small class="text-muted font-monospace" dir="ltr">@@@u.BaleUsername</small>
                                                }
                                            </td>
                                            <td dir="ltr" class="font-monospace text-start">
                                                @(string.IsNullOrWhiteSpace(u.PhoneNumber) ? "-" : u.PhoneNumber)
                                            </td>
                                            <td class="font-monospace">
                                                @(string.IsNullOrWhiteSpace(u.NationalId) ? "-" : u.NationalId)
                                            </td>
                                            <td>
                                                <code class="text-dark bg-light px-2 py-1 rounded">@u.ChatId</code>
                                            </td>
                                            <td>
                                                @if (u.Source == "کاربر سامانه")
                                                {
                                                    <span class="badge bg-success">کاربر سامانه</span>
                                                }
                                                else if (u.Source == "متقاضی کارپوشه")
                                                {
                                                    <span class="badge bg-info text-dark">متقاضی کارپوشه</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">کاربر ربات</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" title="تنظیم به عنوان مخاطب تکی" onclick="setDirectChat('@u.ChatId')">
                                                    <i class="fas fa-reply"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer bg-light py-2 small d-flex justify-content-between text-muted">
                        <span id="visibleRowsCounter">نمایش @Model.Users.Count مخاطب</span>
                        <span>با انتخاب چند کاربر می‌توانید پیام گروهی ارسال نمایید</span>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function updateSelectedCount() {
            const checks = document.querySelectorAll('.user-check:checked');
            const count = checks.length;
            document.getElementById('selectedCounterBadge').innerText = count + ' کاربر انتخاب شده';
            document.getElementById('btnSelectedCount').innerText = count;

            const total = document.querySelectorAll('.user-check').length;
            const master = document.getElementById('masterCheckbox');
            if (master) {
                master.checked = (total > 0 && count === total);
                master.indeterminate = (count > 0 && count < total);
            }
        }

        function toggleAllCheckboxes(checked) {
            document.querySelectorAll('.user-row').forEach(function (row) {
                if (row.style.display !== 'none') {
                    const cb = row.querySelector('.user-check');
                    if (cb) cb.checked = checked;
                }
            });
            updateSelectedCount();
        }

        function toggleMaster(master) {
            toggleAllCheckboxes(master.checked);
        }

        function filterUserTable() {
            const search = document.getElementById('userSearchInput').value.toLowerCase().trim();
            const source = document.getElementById('sourceFilterSelect').value;
            const rows = document.querySelectorAll('#usersTable tbody tr.user-row');
            let visibleCount = 0;

            rows.forEach(function (row) {
                const text = row.innerText.toLowerCase();
                const rowSource = row.getAttribute('data-source') || '';

                const matchesSearch = !search || text.includes(search);
                const matchesSource = !source || rowSource === source;

                if (matchesSearch && matchesSource) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            document.getElementById('visibleRowsCounter').innerText = 'نمایش ' + visibleCount + ' مخاطب';
        }

        function setDirectChat(chatId) {
            const input = document.getElementById('directChatIdInput');
            if (input) {
                input.value = chatId;
                input.scrollIntoView({ behavior: 'smooth', block: 'center' });
                input.focus();
                input.classList.add('is-valid');
                setTimeout(() => input.classList.remove('is-valid'), 2000);
            }
        }

        function confirmSendSelected() {
            const count = document.querySelectorAll('.user-check:checked').length;
            if (count === 0) {
                alert('لطفاً حداقل یک کاربر را انتخاب نمایید.');
                return false;
            }
            const msg = document.getElementById('messageTextInput').value.trim();
            if (!msg) {
                alert('لطفاً متن پیام را وارد فرمایید.');
                return false;
            }
            return confirm('آیا از ارسال این پیام به ' + count + ' کاربر انتخاب‌شده در بله اطمینان دارید؟');
        }

        function confirmDirectSend() {
            const cid = document.getElementById('directChatIdInput').value.trim();
            if (!cid) {
                alert('لطفاً شناسه چت مقصد را وارد نمایید.');
                return false;
            }
            const msg = document.getElementById('messageTextInput').value.trim();
            if (!msg) {
                alert('لطفاً متن پیام را وارد فرمایید.');
                return false;
            }
            return confirm('آیا از ارسال پیام به شناسه چت ' + cid + ' اطمینان دارید؟');
        }
    </script>
}
