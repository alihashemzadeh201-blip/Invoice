@page
@model Invoice.Pages.Admin.DatabaseBackup.IndexModel
@{
    ViewBag.Title = "پشتیبان‌گیری پایگاه داده";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 text-primary">
                <i class="fas fa-database me-2"></i> پشتیبان‌گیری از پایگاه داده (Database Backup)
            </h4>
            <p class="text-muted small mb-0">ایجاد نسخه پشتیبان کامل از دیتابیس سامانه و دانلود مستقیم بر روی سیستم شما</p>
        </div>
        <a asp-page="/Admin/Users/Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-right me-1"></i> بازگشت به مدیریت کاربران
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>خطا:</strong> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }

    <!-- اطلاعات پایگاه داده -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle p-3 bg-primary bg-opacity-10 text-primary me-3">
                        <i class="fas fa-database fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-muted small">نام پایگاه داده</div>
                        <div class="fw-bold fs-6">@(string.IsNullOrEmpty(Model.DbInfo.DatabaseName) ? "نامشخص" : Model.DbInfo.DatabaseName)</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle p-3 bg-info bg-opacity-10 text-info me-3">
                        <i class="fas fa-server fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-muted small">سرور دیتابیس</div>
                        <div class="fw-bold fs-6">@(string.IsNullOrEmpty(Model.DbInfo.ServerName) ? "نامشخص" : Model.DbInfo.ServerName)</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle p-3 bg-success bg-opacity-10 text-success me-3">
                        <i class="fas fa-table fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-muted small">جداول و رکوردها</div>
                        <div class="fw-bold fs-6">
                            @Model.DbInfo.TotalTablesCount جدول <span class="text-muted small">(@Model.DbInfo.TotalRowsCount.ToString("N0") رکورد)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle p-3 bg-warning bg-opacity-10 text-warning me-3">
                        <i class="fas fa-hdd fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-muted small">حجم داده‌ها (تقریبی)</div>
                        <div class="fw-bold fs-6">
                            @(Model.DbInfo.DatabaseSizeMb.HasValue ? $"{Model.DbInfo.DatabaseSizeMb:N1} مگابایت" : "در حال محاسبه...")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- فرم ایجاد و دانلود بک‌آپ -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 text-dark">
                <i class="fas fa-cloud-download-alt text-primary me-2"></i> تهیه و دانلود نسخه پشتیبان
            </h5>
        </div>
        <div class="card-body p-4">
            <form method="post" asp-page-handler="Download" id="backupForm">
                @Html.AntiForgeryToken()

                <div class="alert alert-info border-0 d-flex align-items-center mb-4">
                    <i class="fas fa-info-circle fa-2x me-3 text-info"></i>
                    <div>
                        <strong>ویژگی‌های نسخه پشتیبان خودکار:</strong>
                        <ul class="mb-0 mt-1 ps-3">
                            <li><strong>کامل و مستقل:</strong> شامل تمامی ساختارها (DDL)، کلیدهای اصلی، روابط خارجی (Foreign Keys) و تمامی داده‌های جداول است.</li>
                            <li><strong>سازگاری جهانی:</strong> فایل تولیدشده بدون نیاز به دسترسی‌های ویژه سطح سرور (مانند sysadmin یا BulkAdmin) ایجاد شده و در هر نسخه‌ای از SQL Server قابل بازیابی (Restore) است.</li>
                            <li><strong>بدون قطعی:</strong> عملیات به صورت برخط و همزمان با استفاده عادی کاربران از سیستم انجام می‌شود.</li>
                        </ul>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-8">
                        <label class="form-label fw-bold">نوع و قالب فایل خروجی:</label>
                        <div class="border rounded p-3 bg-light">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" asp-for="BackupFormat" value="zip" id="formatZip" checked>
                                <label class="form-check-label fw-bold" for="formatZip">
                                    <i class="fas fa-file-archive text-warning me-1"></i> آرشیو فشرده اسکریپت کامل پایگاه داده (.zip)
                                    <span class="badge bg-success ms-2">توصیه شده</span>
                                </label>
                                <div class="form-text text-muted ps-4">
                                    حاوی اسکریپت جامع SQL با تمام ساختارها و داده‌ها در قالب فشرده با حجم اندک (~۱ الی ۲ مگابایت). قابل اجرا در SSMS روی هر کامپیوتر.
                                </div>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="BackupFormat" value="bak" id="formatBak">
                                <label class="form-check-label" for="formatBak">
                                    <i class="fas fa-database text-primary me-1"></i> فایل باینری بک‌آپ SQL Server (.bak)
                                </label>
                                <div class="form-text text-muted ps-4">
                                    ایجاد مستقیم فایل .bak در دیسک محلی سرور SQL (مناسب زمانی که وب‌سرور و سرور دیتابیس مشترک باشند).
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 d-flex align-items-center">
                        <div class="p-3 bg-light rounded border w-100">
                            <div class="small text-muted mb-2">
                                <i class="fas fa-shield-alt text-success me-1"></i> <strong>سطح امنیت:</strong>
                            </div>
                            <div class="small text-muted mb-1">• دسترسی منحصر به مدیر سامانه</div>
                            <div class="small text-muted mb-1">• اعتبارسنجی توکن ضدجعل (Anti-CSRF)</div>
                            <div class="small text-muted">• پاک‌سازی خودکار فایل‌های موقت پس از اتمام دانلود</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <button type="submit" class="btn btn-success btn-lg px-4" id="btnStartBackup">
                        <i class="fas fa-download me-2"></i> تهیه و دانلود فایل پشتیبان
                    </button>
                    <span class="text-muted small">
                        <i class="fas fa-check-double text-success me-1"></i> دیتابیس آماده دریافت پشتیبان است
                    </span>
                </div>
            </form>

            <!-- کادر وضعیت هنگام در حال پردازش بودن -->
            <div id="backupProgressBox" class="mt-4 p-3 bg-light rounded border text-center" style="display: none;">
                <div class="spinner-border text-primary mb-2" role="status">
                    <span class="visually-hidden">در حال انجام...</span>
                </div>
                <div class="fw-bold text-primary">در حال تهیه نسخه پشتیبان از پایگاه داده و آماده‌سازی فایل دانلود...</div>
                <small class="text-muted">لطفاً تا شروع دانلود شکیبا باشید و این صفحه را نبندید یا رفرش نکنید (معمولاً چند ثانیه زمان می‌برد).</small>
            </div>
        </div>
    </div>

    <!-- مشخصات تکمیلی موتور دیتابیس -->
    @if (!string.IsNullOrEmpty(Model.DbInfo.SqlVersion))
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-3 bg-light rounded d-flex justify-content-between align-items-center">
                <div class="small text-muted">
                    <i class="fas fa-info me-1"></i> <strong>نسخه موتور SQL Server:</strong> @Model.DbInfo.SqlVersion
                </div>
                <div class="small text-muted">
                    <i class="fas fa-clock me-1"></i> <strong>زمان سرور:</strong> @MyDate.GetPersianDate(Model.DbInfo.ServerDateTime)
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('backupForm');
            var btn = document.getElementById('btnStartBackup');
            var progressBox = document.getElementById('backupProgressBox');

            if (form && btn && progressBox) {
                form.addEventListener('submit', function () {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>در حال ایجاد پشتیبان...';
                    progressBox.style.display = 'block';

                    // پس از ارسال، دکمه پس از چند ثانیه به حالت عادی برگردد تا کاربر در صورت نیاز دوباره دانلود کند
                    setTimeout(function () {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-download me-2"></i> تهیه و دانلود فایل پشتیبان';
                    }, 25000);
                });
            }
        });
    </script>
}
