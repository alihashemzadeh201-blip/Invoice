@page
@model Invoice.Pages.Admin.ActivityLogs.IndexModel
@{
    ViewBag.Title = "گزارش فعالیت کاربران";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1 text-primary">
                <i class="fas fa-clipboard-list me-2"></i> گزارش و لاگ فعالیت کاربران (Audit Logs)
            </h4>
            <p class="text-muted small mb-0">رهگیری دقیق تمامی رویدادها، عملیات فاکتورها، ارسال‌ها به سامانه مودیان و ورود کاربران با ذکر زمان دقیق</p>
        </div>
        <div>
            <a asp-page="/Admin/Users/Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-right me-1"></i> مدیریت کاربران
            </a>
            <a asp-page="/Admin/DatabaseBackup/Index" class="btn btn-outline-primary btn-sm ms-1">
                <i class="fas fa-database me-1"></i> پشتیبان دیتابیس
            </a>
        </div>
    </div>

    <!-- کارت‌های آمار سریع -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center py-3">
                    <div class="rounded-circle p-3 bg-primary bg-opacity-10 text-primary me-3">
                        <i class="fas fa-list-ul fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-muted small">کل رویدادهای ثبت‌شده</div>
                        <div class="fw-bold fs-5">@Model.TotalLogsCount.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center py-3">
                    <div class="rounded-circle p-3 bg-success bg-opacity-10 text-success me-3">
                        <i class="fas fa-file-invoice fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-muted small">عملیات فاکتور و مودیان</div>
                        <div class="fw-bold fs-5 text-success">@Model.InvoiceLogsCount.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center py-3">
                    <div class="rounded-circle p-3 bg-info bg-opacity-10 text-info me-3">
                        <i class="fas fa-calendar-day fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-muted small">فعالیت‌های امروز</div>
                        <div class="fw-bold fs-5 text-info">@Model.TodayLogsCount.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center py-3">
                    <div class="rounded-circle p-3 bg-danger bg-opacity-10 text-danger me-3">
                        <i class="fas fa-exclamation-triangle fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-muted small">خطاها و هشدارها</div>
                        <div class="fw-bold fs-5 text-danger">@Model.ErrorLogsCount.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- فرم فیلتر و جستجو -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-4 col-sm-12">
                    <label class="form-label small text-muted mb-1">جستجو در شرح، شناسه فاکتور یا کاربر:</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" class="form-control" asp-for="Search" placeholder="شماره فاکتور، متن رویداد، نام کاربری..." />
                    </div>
                </div>
                <div class="col-md-2 col-sm-6">
                    <label class="form-label small text-muted mb-1">دسته‌بندی:</label>
                    <select class="form-select form-select-sm" asp-for="Category" asp-items="Model.CategoriesList">
                        <option value="">همه دسته‌ها</option>
                    </select>
                </div>
                <div class="col-md-2 col-sm-6">
                    <label class="form-label small text-muted mb-1">کاربر:</label>
                    <select class="form-select form-select-sm" asp-for="SelectedUser" asp-items="Model.UsersList">
                        <option value="">همه کاربران</option>
                    </select>
                </div>
                <div class="col-md-2 col-sm-6">
                    <label class="form-label small text-muted mb-1">وضعیت:</label>
                    <select class="form-select form-select-sm" asp-for="Status" asp-items="Model.StatusList">
                        <option value="">همه وضعیت‌ها</option>
                    </select>
                </div>
                <div class="col-md-2 col-sm-6 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                        <i class="fas fa-filter me-1"></i> فیلتر
                    </button>
                    <a asp-page="./Index" class="btn btn-outline-secondary btn-sm" title="پاک کردن فیلترها">
                        <i class="fas fa-times"></i>
                    </a>
                </div>
            </form>

            <!-- فیلترهای سریع -->
            <div class="d-flex flex-wrap gap-1 mt-2 pt-2 border-top">
                <span class="small text-muted align-self-center me-1">فیلترهای سریع:</span>
                <a asp-page="./Index" asp-route-category="فاکتور" class="badge bg-light text-primary border text-decoration-none py-1 px-2">
                    <i class="fas fa-file-invoice me-1"></i> فقط عملیات فاکتور
                </a>
                <a asp-page="./Index" asp-route-status="خطا" class="badge bg-light text-danger border text-decoration-none py-1 px-2">
                    <i class="fas fa-times-circle me-1"></i> خطاهای سیستم
                </a>
                <a asp-page="./Index" asp-route-category="حساب کاربری" class="badge bg-light text-info border text-decoration-none py-1 px-2">
                    <i class="fas fa-sign-in-alt me-1"></i> ورود کاربران
                </a>
            </div>
        </div>
    </div>

    <!-- جدول لاگ‌ها -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold text-secondary">
                <i class="fas fa-history me-1 text-primary"></i> نتایج رویدادها (@Model.TotalItems.ToString("N0") لاگ یافت شد)
            </span>
            <span class="small text-muted">
                صفحه @Model.PageNumber از @(Math.Max(1, Model.TotalPages))
            </span>
        </div>

        @if (!Model.Logs.Any())
        {
            <div class="card-body text-center py-5">
                <div class="text-muted mb-2">
                    <i class="fas fa-inbox fa-3x text-secondary opacity-50"></i>
                </div>
                <h6 class="text-secondary">هیچ لاگی با فیلترهای انتخاب‌شده یافت نشد.</h6>
                <a asp-page="./Index" class="btn btn-outline-primary btn-sm mt-2">
                    مشاهده تمام لاگ‌ها
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-sm" style="font-size: 0.92rem;">
                    <thead class="table-light">
                        <tr>
                            <th class="text-nowrap" style="width: 140px;">
                                <i class="fas fa-clock text-muted me-1"></i> زمان دقیق (شمسی)
                            </th>
                            <th class="text-nowrap" style="width: 120px;">کاربر</th>
                            <th class="d-none d-md-table-cell text-nowrap" style="width: 160px;">پروفایل مودی</th>
                            <th class="text-nowrap" style="width: 110px;">دسته‌بندی</th>
                            <th class="text-nowrap" style="width: 130px;">عملیات</th>
                            <th>شرح رویداد</th>
                            <th class="text-nowrap d-none d-lg-table-cell" style="width: 110px;">شناسه مرتبط</th>
                            <th class="text-nowrap text-center" style="width: 80px;">وضعیت</th>
                            <th class="text-nowrap d-none d-xl-table-cell text-muted" style="width: 110px;">IP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td class="text-nowrap">
                                    <div class="fw-bold text-dark">
                                        @(MyDate.GetPersianDate(log.Timestamp)?.ToString() ?? "-")
                                    </div>
                                    <div class="small text-muted font-monospace" dir="ltr" style="font-size: 0.8rem;">
                                        @log.Timestamp.ToString("HH:mm:ss")
                                    </div>
                                </td>
                                <td class="text-nowrap">
                                    <div class="fw-bold text-primary">@log.Username</div>
                                    @if (!string.IsNullOrEmpty(log.UserRole))
                                    {
                                        <span class="badge @(log.UserRole == "admin" ? "bg-danger" : (log.UserRole == "reseller" ? "bg-info" : "bg-secondary")) bg-opacity-75" style="font-size: 0.7rem;">
                                            @log.UserRole
                                        </span>
                                    }
                                </td>
                                <td class="d-none d-md-table-cell small text-truncate" style="max-width: 160px;" title="@log.ProfileTitle">
                                    @(string.IsNullOrEmpty(log.ProfileTitle) ? "-" : log.ProfileTitle)
                                </td>
                                <td class="text-nowrap">
                                    <span class="badge @(log.Category == "فاکتور" ? "bg-primary" : (log.Category == "حساب کاربری" ? "bg-secondary" : "bg-info")) bg-opacity-10 @(log.Category == "فاکتور" ? "text-primary" : (log.Category == "حساب کاربری" ? "text-secondary" : "text-info")) border">
                                        @log.Category
                                    </span>
                                </td>
                                <td class="text-nowrap fw-bold text-dark">
                                    @log.Action
                                </td>
                                <td>
                                    <div class="text-break" style="max-width: 450px;">
                                        @log.Description
                                    </div>
                                </td>
                                <td class="text-nowrap d-none d-lg-table-cell">
                                    @if (!string.IsNullOrEmpty(log.EntityId))
                                    {
                                        if (log.Category == "فاکتور" && int.TryParse(log.EntityId, out _))
                                        {
                                            <a asp-page="/InvoiceManage/InvoiceConfirm" asp-route-id="@log.EntityId" class="badge bg-light text-primary border text-decoration-none" title="مشاهده فاکتور">
                                                فاکتور #@log.EntityId
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="font-monospace small text-muted">@log.EntityId</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-nowrap text-center">
                                    @if (log.Status == "موفق")
                                    {
                                        <span class="badge bg-success bg-opacity-75">
                                            <i class="fas fa-check me-1"></i> موفق
                                        </span>
                                    }
                                    else if (log.Status == "خطا")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fas fa-times me-1"></i> خطا
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fas fa-exclamation me-1"></i> @log.Status
                                        </span>
                                    }
                                </td>
                                <td class="text-nowrap d-none d-xl-table-cell font-monospace small text-muted" dir="ltr">
                                    @(string.IsNullOrEmpty(log.IpAddress) ? "-" : log.IpAddress)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- صفحه‌بندی -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
                    <span class="small text-muted">
                        نمایش @(((Model.PageNumber - 1) * Model.PageSize) + 1) تا @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItems)) از @Model.TotalItems.ToString("N0") لاگ
                    </span>
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-page="./Index"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   asp-route-search="@Model.Search"
                                   asp-route-category="@Model.Category"
                                   asp-route-selectedUser="@Model.SelectedUser"
                                   asp-route-status="@Model.Status">قبلی</a>
                            </li>

                            @{
                                int startPage = Math.Max(1, Model.PageNumber - 2);
                                int endPage = Math.Min(Model.TotalPages, startPage + 4);
                                if (endPage - startPage < 4)
                                {
                                    startPage = Math.Max(1, endPage - 4);
                                }
                            }

                            @for (int p = startPage; p <= endPage; p++)
                            {
                                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-page="./Index"
                                       asp-route-pageNumber="@p"
                                       asp-route-search="@Model.Search"
                                       asp-route-category="@Model.Category"
                                       asp-route-selectedUser="@Model.SelectedUser"
                                       asp-route-status="@Model.Status">@p</a>
                                </li>
                            }

                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-page="./Index"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   asp-route-search="@Model.Search"
                                   asp-route-category="@Model.Category"
                                   asp-route-selectedUser="@Model.SelectedUser"
                                   asp-route-status="@Model.Status">بعدی</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
