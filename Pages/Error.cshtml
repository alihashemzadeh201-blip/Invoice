@page
@model ErrorModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "خطا";
}

<h1 class="text-danger">خطای پیش بینی نشده</h1>
<h2 class="text-danger">در پردازش این صفحه خطایی رخ داده </h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>ضمن عرض پوزش بابت خطای پیش آمده ، لطفا مجددا تلاش کنید و در صورت تکرار این خطا با پشتیبان سایت تماس حاصل نمایید.</p>
