@page
@model LoginModel

@{
    ViewData["Title"] = "ورود";
}
<div class="text-center d-inline-block w-100" >
    <div class="col-md-4 float-none m-auto mb-4">
        <section>
            <form id="account" method="post">
                <p class="strong red-text">نام کاربری و رمز عبور خود را جهت ورود وارد نمایید.</p>
                @if (ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger" asp-validation-summary="All"></div>
            }
                <div class="form-group">
                    <label asp-for="Input.Username"></label>
                    <input asp-for="Input.Username" class="form-control" />
                    <span asp-validation-for="Input.Username" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password" class="form-control" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.RememberMe" class="float-left"></label>
                    <label class="checkbox-container float-left">
                        <input asp-for="Input.RememberMe" />
                        <span class="checkmark"></span>
                    </label>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-success w-100">ورود</button>
                    <a class="btn btn-outline-success w-100 mt-3" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl"> ثبت نام </a>
                </div>
              
            </form>
        </section>

    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
