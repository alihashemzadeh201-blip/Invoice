@page
@model Invoice.Pages.StuffPages.IndexModel
@{
    ViewBag.Title = "بانک کالاها و علاقه‌مندی‌ها";
    Layout = "~/Pages/Shared/_layout.cshtml";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h4 class="mb-1 text-primary">
                <i class="fas fa-boxes me-2"></i> بانک شناسه‌های کالا و خدمات سامانه مودیان
            </h4>
            <span class="text-muted small">
                جستجو در بین کالاها و مدیریت لیست علاقه‌مندی‌ها جهت استفاده سریع در صدور فاکتور
            </span>
        </div>
        <div>
            <a asp-page="/Product/Index" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-list me-1"></i> مشاهده لیست کالاهای من
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-3" role="alert">
            <i class="fas fa-check-circle me-2"></i> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }

    <!-- Tabs -->
    <ul class="nav nav-pills mb-3 border-bottom pb-2">
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "fav" ? "active" : "")" asp-page="./Index" asp-route-Tab="fav">
                <i class="fas fa-star me-1 text-warning"></i> کالاهای منتخب من
                <span class="badge @(Model.Tab == "fav" ? "bg-white text-primary" : "bg-warning text-dark") rounded-pill ms-1">
                    @Model.FavoritesCount
                </span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "all" ? "active" : "")" asp-page="./Index" asp-route-Tab="all">
                <i class="fas fa-search me-1"></i> جستجو در کل شناسه‌ها
            </a>
        </li>
    </ul>

    <!-- Search Box -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <input type="hidden" name="Tab" value="@Model.Tab" />
                <div class="col-md-9">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" asp-for="Search" placeholder="جستجو بر اساس شناسه کالا (۱۳ رقم) یا شرح کالا و خدمت..." />
                    </div>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="fas fa-search me-1"></i> جستجو
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <a asp-page="./Index" asp-route-Tab="@Model.Tab" class="btn btn-outline-secondary">پاک کردن</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;" class="text-center">⭐</th>
                            <th style="width: 180px;">شناسه کالا/خدمت</th>
                            <th>شرح کالا/خدمت</th>
                            <th style="width: 120px;" class="text-center">نرخ مالیات (٪)</th>
                            <th style="width: 150px;" class="text-center">نوع شناسه</th>
                            <th style="width: 100px;" class="text-center">مشمولیت</th>
                            <th style="width: 160px;" class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fas fa-box-open fa-3x mb-3 text-secondary d-block"></i>
                                    @if (Model.Tab == "fav")
                                    {
                                        <span>لیست کالاهای منتخب شما خالی است. با مراجعه به تب «جستجو در کل شناسه‌ها» می‌توانید کالاهای پرمصرف خود را ستاره‌دار کنید.</span>
                                    }
                                    else
                                    {
                                        <span>هیچ موردی با مشخصات جستجو شده یافت نشد.</span>
                                    }
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="text-center">
                                        <form method="post" asp-page-handler="ToggleFavorite" class="d-inline">
                                            <input type="hidden" name="code" value="@item.Code" />
                                            <input type="hidden" name="returnTab" value="@Model.Tab" />
                                            <input type="hidden" name="search" value="@Model.Search" />
                                            <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                            <button type="submit" class="btn btn-link p-0 text-decoration-none shadow-none" title="@(item.IsFavorite ? "حذف از منتخب‌ها" : "افزودن به منتخب‌ها")">
                                                @if (item.IsFavorite)
                                                {
                                                    <i class="fas fa-star text-warning fa-lg"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star text-muted fa-lg"></i>
                                                }
                                            </button>
                                        </form>
                                    </td>
                                    <td>
                                        <code class="fw-bold text-dark font-monospace" dir="ltr">@item.Code</code>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@item.Title</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@item.VatRate %</span>
                                    </td>
                                    <td class="text-center small text-muted">
                                        @item.Type.ToString().Replace("_", " ")
                                    </td>
                                    <td class="text-center">
                                        @if (item.VatTax)
                                        {
                                            <span class="badge bg-success-subtle text-success">مشمول</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">معاف</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            @if (item.IsInProducts)
                                            {
                                                <span class="badge bg-success-subtle text-success py-2 px-2" title="این کالا قبلاً در لیست کالاهای شما ثبت شده است">
                                                    <i class="fas fa-check me-1"></i> در کالاهای من
                                                </span>
                                            }
                                            else
                                            {
                                                <form method="post" asp-page-handler="AddToProducts" class="d-inline">
                                                    <input type="hidden" name="code" value="@item.Code" />
                                                    <input type="hidden" name="returnTab" value="@Model.Tab" />
                                                    <input type="hidden" name="search" value="@Model.Search" />
                                                    <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                                    <button type="submit" class="btn btn-outline-success btn-sm" title="افزودن به لیست کالاهای من جهت صدور فاکتور">
                                                        <i class="fas fa-plus me-1"></i> ثبت در کالاهای من
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                <span class="text-muted small">
                    صفحه @Model.PageNumber از @Model.TotalPages (نمایش @Model.Items.Count از @Model.TotalCount.ToString("N0") مورد)
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @if (Model.PageNumber > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Index" asp-route-Tab="@Model.Tab" asp-route-Search="@Model.Search" asp-route-PageNumber="@(Model.PageNumber - 1)">قبلی</a>
                            </li>
                        }

                        @{
                            var startPage = Math.Max(1, Model.PageNumber - 2);
                            var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                        }

                        @for (var p = startPage; p <= endPage; p++)
                        {
                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-page="./Index" asp-route-Tab="@Model.Tab" asp-route-Search="@Model.Search" asp-route-PageNumber="@p">@p</a>
                            </li>
                        }

                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Index" asp-route-Tab="@Model.Tab" asp-route-Search="@Model.Search" asp-route-PageNumber="@(Model.PageNumber + 1)">بعدی</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
