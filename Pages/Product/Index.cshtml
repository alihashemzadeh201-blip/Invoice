@page
@model Invoice.Pages_Product.IndexModel

@{
    ViewBag.Title = "لیست کالاها و خدمات";
}

<p>
    <a asp-page="Create" class="btn btn-outline-info">کالا/خدمت جدید <span class="fa fa-plus"></span></a>
</p>
<form method="post">
    <div class="input-group mt-3">
        <input type="text" class="form-control" asp-for="Search" />
        <button class="input-group-text"><i class="fa fa-search"></i></button>
    </div>
</form>
<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Product[0].Sstt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Product[0].Sstid)
            </th>
            <th class="d-none d-md-table-cell">
                @Html.DisplayNameFor(model => model.Product[0].MeasureUnit)
            </th>
            <th class="d-none d-md-table-cell">
                @Html.DisplayNameFor(model => model.Product[0].Fee)
            </th>
            <th class="d-none d-md-table-cell">
                @Html.DisplayNameFor(model => model.Product[0].Vra)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Product) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Sstt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sstid)
            </td>
            <td class="d-none d-md-table-cell">
                @item.MeasureUnit?.Title
            </td>
            <td class="d-none d-md-table-cell">
                @Html.DisplayFor(modelItem => item.Fee)
            </td>
            <td class="d-none d-md-table-cell">
                @Html.DisplayFor(modelItem => item.Vra)
            </td>
            <td>
                <a asp-page="./Create" asp-route-id="@item.Id"><span class="fa fa-edit"></span></a> 
                <a asp-page="./Details" asp-route-id="@item.Id"><span class="fa fa-eye"></span></a> 
                <a asp-page-handler="Delete" asp-route-id="@item.Id" onclick="return confirm('@Messages.DeleteConfirm')"><span class="fa fa-trash"></span></a>
            </td>
        </tr>
}
        </table>
  