<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@ViewBag.Description" />
    @if (ViewBag.Canonical != null)
    {
        <link rel="canonical" href="@ViewBag.Canonical" />
    }
    @if (ViewBag.KeyWords != null)
    {
        <meta name="keywords" content="@ViewBag.KeyWords" />
    }
    <link rel="icon" type="image/x-icon" href="/images/fav.jpg" />
    <title>@ViewData["Title"] - سامانه فاکتور الکترونیکی</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/lib/bootstrap-rtl/css/bootstrap-rtl.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Invoice.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css">
    @*<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css">*@
    <link href="~/lib/date-picker/css/persianDatepicker-default.css" rel="stylesheet" />

    <link href="~/lib/search-select/select2.min.css" rel="stylesheet" />
</head>
<body lang="fa" itemscope="itemscope" itemtype="http://schema.org/WebPage">
    <header class="not-print">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-light-blue border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                <img src="~/images/logo.png" width="30px" />
                 فاکتور الکترونیک
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                       
                        @if (User.IsInRole("admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/admin/users/index">مدیریت کاربران</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/admin/users/profiles">لیست پروفایل ها</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/admin/transaction/index">درخواست اعتبار</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/admin/requests/index">درخواست کارپوشه</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/product/index">مدیریت کالا/خدمت</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/invoicemanage/index">صدور فاکتور</a>
                            </li>
                             <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/product/index">مدیریت کالا/خدمت</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/credit/vallet">کیف پول من</a>
                            </li>
                           @if (User.IsInRole("user"))
                           {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/credit/creditrequest">تمدید دوره</a>
                            </li>
                           }
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/account/userprofile">ناحیه کاربری</a>
                            </li>
                           
                        }
                        @if (User.IsInRole("reseller"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/admin/users/profiles">مدیریت پروفایل</a>
                            </li>

                        }


                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <div class="form @(ViewBag.NarrowForm==true?"narrow-form":"")">
                @if (ViewBag.Title != null)
                {
                <h1 class="title">
                    <span>@ViewBag.Title</span>
                </h1>
                }
                @RenderBody()
            </div>
        </main>
    </div>
   @* <div  class="bottom-buttons">
        <div class="container">
        @RenderSection("Buttons",required:false)
        </div>
    </div>*@
    <footer class="border-top footer text-muted bg-light-blue not-print">
        <div class="container">
            <div class="text-center strong mt-2 text-danger w-100"> سامانه فاکتور الکترونیکی</div>
            <div class="row">
                <div class="contact-us mt-4 col-md-6">
                    <strong>تماس با ما</strong>
                    <div class="mt-2">
                        <label class="text-danger">موبایل : </label>
                        <span class="ms-2 me-2">09354182557</span><span class="fa fa-phone"></span>
                    </div>
                    <div class="mt-2">
                        <label class="text-danger">تلفن : </label>
                        <span class="ms-2 me-2">051-42631163</span><span class="fa fa-fax"></span>
                    </div>
                </div>
                <div class="col-md-6 mt-4 social-icons">
                    <strong>شبکه های اجتماعی</strong>
                    <div class=" mt-2">
                        <a href="https://t.me/+989354182557" target="_blank" class="telegram" title="تلگرام">
                            <i class="fab fa-telegram"></i>
                        </a>

                        <!-- واتساپ -->
                        <a href="https://wa.me/+989354182557" target="_blank" class="whatsapp" title="واتساپ">
                            <i class="fab fa-whatsapp"></i>
                        </a>

                        <!-- ایتا -->
                        <a href="https://eitaa.com/+989354182557" target="_blank" class="eitaa" title="ایتا">
                            <img src="~/images/Eitaa_Icon.png" alt="Eitaa">
                        </a>

                        <!-- روبیکا -->
                        <a href="https://rubika.ir/AliHashemi2025" target="_blank" class="rubika" title="روبیکا">
                            <img src="~/images/Rubika_Icon.png" alt="Rubika">
                        </a>
                    </div>
                </div>
            </div>
            <hr />
            <div class="text-center">
                &copy; 2023 - Electronic Invoice - <a asp-area="" asp-page="#">حریم خصوصی</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/wordifyfa.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>