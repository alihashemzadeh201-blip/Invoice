@inject Invoice.Code.ISelectedProfile profile
@inject Invoice.Code.IScopedFields fields
@{
    var reqPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
    bool IsActive(params string[] paths)
    {
        foreach (var p in paths)
        {
            var lp = p.ToLowerInvariant();
            if (reqPath == lp || reqPath.StartsWith(lp + "/") || reqPath.StartsWith(lp + "?"))
                return true;
        }
        return false;
    }
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سامانه صدور فاکتور </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/lib/bootstrap-rtl/css/bootstrap-rtl.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pwa.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/loading.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Invoice.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css">
    <link href="~/lib/date-picker/css/persianDatepicker-default.css" rel="stylesheet" />
    <link href="~/lib/search-select/select2.min.css" rel="stylesheet" />

    <!-- PWA Meta Tags -->
    <meta name="theme-color" content="#667eea">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="صورتحساب">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/images/icons/icon-192x192.png">

    <!-- iOS Splash Screens -->
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-2048-2732.png" media="(device-width: 1024px) and (device-height: 1366px) and (-webkit-device-pixel-ratio: 2)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-1668-2388.png" media="(device-width: 834px) and (device-height: 1194px) and (-webkit-device-pixel-ratio: 2)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-1536-2048.png" media="(device-width: 768px) and (device-height: 1024px) and (-webkit-device-pixel-ratio: 2)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-1125-2436.png" media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-1242-2688.png" media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 3)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-828-1792.png" media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 2)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-1242-2208.png" media="(device-width: 414px) and (device-height: 736px) and (-webkit-device-pixel-ratio: 3)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-750-1334.png" media="(device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-640-1136.png" media="(device-width: 320px) and (device-height: 568px) and (-webkit-device-pixel-ratio: 2)">

    <!-- PWA Scripts -->
    <script src="/js/pwa-register.js" defer></script>
</head>
<body>
    <!-- Mobile Menu Overlay -->
    <div class="mobile-menu-overlay" id="mobileMenuOverlay"></div>

    <!-- Sidebar -->
    <aside class="@(fields.MenuOpen?"sidebar sidebar-open":"sidebar")" id="sidebar">
        <div class="sidebar-header">
            <a href="/">
                <img src="~/images/logo.png" alt="Logo" />
                <span class="logo-text">صدور فاکتور </span>
            </a>
        </div>

        <ul class="sidebar-menu">
            @if (User.IsInRole("reseller"))
            {
                <li class="menu-item profile-selector-item">
                    <form method="post" id="profileForm" asp-page="/Index" asp-page-handler="SelectProfile">
                        <div class="selected-profile-info" title="@profile.Profile">
                            <div class="profile-selector-header">
                                <span class="menu-icon"><i class="fas fa-building"></i></span>
                                <span class="menu-text profile-label">پروفایل فعال</span>
                            </div>
                            <select class="profile-select" name="selectedProfileId" onchange="document.getElementById('profileForm').submit()">
                                @foreach (var p in profile.GetProfiles(User.Identity.Name))
                                {
                                    <option value="@p.Id" selected="@(p.Id == profile.ProfileId)">@p.DisplayName</option>
                                }
                            </select>
                        </div>
                    </form>
                </li>
            }

            <li class="menu-item">
                <a class="menu-link @(reqPath == "" || reqPath == "/" || reqPath == "/index" ? "active" : "")" asp-area="" asp-page="/Index" title="پیشخوان">
                    <span class="menu-icon"><i class="fas fa-home"></i></span>
                    <span class="menu-text">پیشخوان</span>
                </a>
            </li>

            @if (User.IsInRole("admin"))
            {
                @* 1. کاربران و پرونده‌ها *@
                <li class="menu-item menu-dropdown @(IsActive("/admin/users", "/admin/requests") ? "open" : "")">
                    <a href="javascript:void(0)" class="menu-link category-toggle" title="کاربران و پرونده‌ها">
                        <span class="menu-icon"><i class="fas fa-users-cog"></i></span>
                        <span class="menu-text">کاربران و پرونده‌ها</span>
                        <span class="menu-arrow"><i class="fas fa-chevron-left"></i></span>
                    </a>
                    <ul class="submenu">
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/admin/users/index") ? "active" : "")" asp-area="" asp-page="/admin/users/index">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">مدیریت کاربران</span>
                            </a>
                        </li>
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/admin/users/profiles") ? "active" : "")" asp-area="" asp-page="/admin/users/profiles">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">لیست پروفایل‌ها</span>
                            </a>
                        </li>
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/admin/requests/index") ? "active" : "")" asp-area="" asp-page="/admin/requests/index">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">درخواست کارپوشه</span>
                            </a>
                        </li>
                    </ul>
                </li>

                @* 2. امور مالی و اعتبارات *@
                <li class="menu-item menu-dropdown @(IsActive("/admin/transaction", "/invoicemanage/customerledger") ? "open" : "")">
                    <a href="javascript:void(0)" class="menu-link category-toggle" title="امور مالی و اعتبارات">
                        <span class="menu-icon"><i class="fas fa-wallet"></i></span>
                        <span class="menu-text">امور مالی و اعتبارات</span>
                        <span class="menu-arrow"><i class="fas fa-chevron-left"></i></span>
                    </a>
                    <ul class="submenu">
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/admin/transaction/index") ? "active" : "")" asp-area="" asp-page="/admin/transaction/index">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">درخواست اعتبار</span>
                            </a>
                        </li>
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/invoicemanage/customerledger") ? "active" : "")" asp-area="" asp-page="/invoiceManage/customerledger">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">مدیریت مالی مشتریان</span>
                            </a>
                        </li>
                    </ul>
                </li>

                @* 3. کالا و خدمات *@
                <li class="menu-item menu-dropdown @(IsActive("/stuff", "/admin/stuffs") ? "open" : "")">
                    <a href="javascript:void(0)" class="menu-link category-toggle" title="کالا و خدمات">
                        <span class="menu-icon"><i class="fas fa-boxes"></i></span>
                        <span class="menu-text">کالا و خدمات</span>
                        <span class="menu-arrow"><i class="fas fa-chevron-left"></i></span>
                    </a>
                    <ul class="submenu">
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/stuff/index") ? "active" : "")" asp-area="" asp-page="/stuff/index">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">کالا و خدمات (منتخب)</span>
                            </a>
                        </li>
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/admin/stuffs") ? "active" : "")" asp-area="" asp-page="/admin/stuffs/index">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">شناسه‌های کالا و خدمات</span>
                            </a>
                        </li>
                    </ul>
                </li>

                @* 4. پیام‌رسان بله *@
                <li class="menu-item menu-dropdown @(IsActive("/admin/bale") ? "open" : "")">
                    <a href="javascript:void(0)" class="menu-link category-toggle" title="پیام‌رسان بله">
                        <span class="menu-icon"><i class="fas fa-paper-plane"></i></span>
                        <span class="menu-text">پیام‌رسان بله</span>
                        <span class="menu-arrow"><i class="fas fa-chevron-left"></i></span>
                    </a>
                    <ul class="submenu">
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/admin/bale/index") ? "active" : "")" asp-area="" asp-page="/admin/bale/index">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">اطلاع‌رسانی بله</span>
                            </a>
                        </li>
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/admin/bale/sendmessage") ? "active" : "")" asp-area="" asp-page="/admin/bale/sendmessage">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">ارسال پیام بله</span>
                            </a>
                        </li>
                    </ul>
                </li>

                @* 5. سیستم و نظارت *@
                <li class="menu-item menu-dropdown @(IsActive("/admin/databasebackup", "/admin/activitylogs") ? "open" : "")">
                    <a href="javascript:void(0)" class="menu-link category-toggle" title="سیستم و نظارت">
                        <span class="menu-icon"><i class="fas fa-shield-alt"></i></span>
                        <span class="menu-text">سیستم و نظارت</span>
                        <span class="menu-arrow"><i class="fas fa-chevron-left"></i></span>
                    </a>
                    <ul class="submenu">
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/admin/databasebackup") ? "active" : "")" asp-area="" asp-page="/admin/databasebackup/index">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">پشتیبان‌گیری دیتابیس</span>
                            </a>
                        </li>
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/admin/activitylogs") ? "active" : "")" asp-area="" asp-page="/admin/activitylogs/index">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">گزارش فعالیت کاربران</span>
                            </a>
                        </li>
                    </ul>
                </li>
            }
            else
            {
                @* 1. مدیریت صورتحساب *@
                <li class="menu-item menu-dropdown @(IsActive("/invoicemanage/createheader", "/invoicemanage/importgroupfactor", "/invoicemanage/index", "/invoicemanage/manualinvoicecancel") ? "open" : "")">
                    <a href="javascript:void(0)" class="menu-link category-toggle" title="مدیریت صورتحساب">
                        <span class="menu-icon"><i class="fas fa-file-invoice"></i></span>
                        <span class="menu-text">مدیریت صورتحساب</span>
                        <span class="menu-arrow"><i class="fas fa-chevron-left"></i></span>
                    </a>
                    <ul class="submenu">
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/invoicemanage/createheader") ? "active" : "")" asp-area="" asp-page="/invoicemanage/createheader">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">فاکتور جدید</span>
                            </a>
                        </li>
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/invoicemanage/importgroupfactor") ? "active" : "")" asp-area="" asp-page="/invoicemanage/ImportGroupFactor">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">ارسال گروهی (اکسل)</span>
                            </a>
                        </li>
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/invoicemanage/index") ? "active" : "")" asp-area="" asp-page="/invoicemanage/index">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">لیست فاکتورها</span>
                            </a>
                        </li>
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/invoicemanage/manualinvoicecancel") ? "active" : "")" asp-area="" asp-page="/invoicemanage/manualinvoicecancel">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">ابطال فاکتور</span>
                            </a>
                        </li>
                    </ul>
                </li>

                @* 2. کالا و خدمات *@
                <li class="menu-item menu-dropdown @(IsActive("/stuff") ? "open" : "")">
                    <a href="javascript:void(0)" class="menu-link category-toggle" title="کالا و خدمات">
                        <span class="menu-icon"><i class="fas fa-boxes"></i></span>
                        <span class="menu-text">کالا و خدمات</span>
                        <span class="menu-arrow"><i class="fas fa-chevron-left"></i></span>
                    </a>
                    <ul class="submenu">
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/stuff/index") ? "active" : "")" asp-area="" asp-page="/stuff/index">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">کالا و خدمات (منتخب)</span>
                            </a>
                        </li>
                    </ul>
                </li>

                @* 3. امور مالی و کیف پول *@
                <li class="menu-item menu-dropdown @(IsActive("/credit", "/invoicemanage/customerledger") ? "open" : "")">
                    <a href="javascript:void(0)" class="menu-link category-toggle" title="امور مالی و کیف پول">
                        <span class="menu-icon"><i class="fas fa-wallet"></i></span>
                        <span class="menu-text">امور مالی و کیف پول</span>
                        <span class="menu-arrow"><i class="fas fa-chevron-left"></i></span>
                    </a>
                    <ul class="submenu">
                        <li class="submenu-item">
                            <a class="submenu-link @(IsActive("/credit/vallet") ? "active" : "")" asp-area="" asp-page="/credit/vallet">
                                <i class="fas fa-circle submenu-bullet"></i>
                                <span class="submenu-text">کیف پول من</span>
                            </a>
                        </li>
                        @if (User.IsInRole("user"))
                        {
                            <li class="submenu-item">
                                <a class="submenu-link @(IsActive("/credit/creditrequest") ? "active" : "")" asp-area="" asp-page="/credit/creditrequest">
                                    <i class="fas fa-circle submenu-bullet"></i>
                                    <span class="submenu-text">تمدید دوره</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("reseller") || User.IsInRole("admin"))
                        {
                            <li class="submenu-item">
                                <a class="submenu-link @(IsActive("/invoicemanage/customerledger") ? "active" : "")" asp-area="" asp-page="/invoiceManage/customerledger">
                                    <i class="fas fa-circle submenu-bullet"></i>
                                    <span class="submenu-text">مدیریت مالی مشتریان</span>
                                </a>
                            </li>
                        }
                    </ul>
                </li>

                @if (User.IsInRole("reseller"))
                {
                    @* 4. پنل نمایندگی *@
                    <li class="menu-item menu-dropdown @(IsActive("/admin/users/profiles") ? "open" : "")">
                        <a href="javascript:void(0)" class="menu-link category-toggle" title="پنل نمایندگی">
                            <span class="menu-icon"><i class="fas fa-user-shield"></i></span>
                            <span class="menu-text">پنل نمایندگی</span>
                            <span class="menu-arrow"><i class="fas fa-chevron-left"></i></span>
                        </a>
                        <ul class="submenu">
                            <li class="submenu-item">
                                <a class="submenu-link @(IsActive("/admin/users/profiles") ? "active" : "")" asp-area="" asp-page="/admin/users/profiles">
                                    <i class="fas fa-circle submenu-bullet"></i>
                                    <span class="submenu-text">مدیریت پروفایل‌ها</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                }
            }
        </ul>

        <div class="user-profile">
            <div class="user-avatar">
                <i class="fas fa-user"></i>
            </div>
            <div class="user-info">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </aside>

    <!-- Main Content -->
