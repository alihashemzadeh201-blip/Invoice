@inject Invoice.Code.ISelectedProfile profile
@inject Invoice.Code.IScopedFields fields
@{
    var reqPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
    bool IsActive(params string[] paths)
    {
        foreach (var p in paths)
        {
            var lp = p.ToLowerInvariant();
            if (reqPath == lp || reqPath.StartsWith(lp + "/") || reqPath.StartsWith(lp + "?"))
                return true;
        }
        return false;
    }
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سامانه صدور فاکتور </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/lib/bootstrap-rtl/css/bootstrap-rtl.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fintech-banking.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pwa.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/loading.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Invoice.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css">
    <link href="~/lib/date-picker/css/persianDatepicker-default.css" rel="stylesheet" />
    <link href="~/lib/search-select/select2.min.css" rel="stylesheet" />

    <!-- PWA Meta Tags -->
    <meta name="theme-color" content="#667eea">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="صورتحساب">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/images/icons/icon-192x192.png">

    <!-- iOS Splash Screens -->
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-2048-2732.png" media="(device-width: 1024px) and (device-height: 1366px) and (-webkit-device-pixel-ratio: 2)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-1668-2388.png" media="(device-width: 834px) and (device-height: 1194px) and (-webkit-device-pixel-ratio: 2)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-1536-2048.png" media="(device-width: 768px) and (device-height: 1024px) and (-webkit-device-pixel-ratio: 2)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-1125-2436.png" media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-1242-2688.png" media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 3)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-828-1792.png" media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 2)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-1242-2208.png" media="(device-width: 414px) and (device-height: 736px) and (-webkit-device-pixel-ratio: 3)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-750-1334.png" media="(device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2)">
    <link rel="apple-touch-startup-image" href="/images/splash/ios-splash-640-1136.png" media="(device-width: 320px) and (device-height: 568px) and (-webkit-device-pixel-ratio: 2)">

    <!-- PWA Scripts -->
    <script src="/js/pwa-register.js" defer></script>
</head>
<body class="fintech-body">
    <!-- Fintech Modern Header -->
    <header class="fintech-header not-print">
        <div class="fintech-header-container">
            <a href="/" class="fintech-brand">
                <img src="~/images/logo.png" alt="Logo" class="fintech-brand-logo" />
                <div>
                    <h1 class="fintech-brand-title">سامانه صدور فاکتور</h1>
                    <p class="fintech-brand-sub">همراه بانک مودیان مالیاتی</p>
                </div>
            </a>

            <div class="fintech-user-actions">
                @if (User.IsInRole("reseller"))
                {
                    <form method="post" id="profileForm" asp-page="/Index" asp-page-handler="SelectProfile" class="d-inline-block m-0">
                        <div class="fintech-profile-pill" title="@profile.Profile?.DisplayName">
                            <i class="fas fa-building text-primary"></i>
                            <select class="fintech-profile-select" name="selectedProfileId" onchange="document.getElementById('profileForm').submit()">
                                @foreach (var p in profile.GetProfiles(User.Identity.Name))
                                {
                                    <option value="@p.Id" selected="@(p.Id == profile.ProfileId)">@p.DisplayName</option>
                                }
                            </select>
                        </div>
                    </form>
                }

                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <div class="main-content">
        @if (ViewBag.Title != null)
        {
            <div class="fintech-page-hero not-print">
                <div class="d-flex align-items-center gap-2">
                    <h2 class="m-0 fs-5 fw-bold text-dark">
                        @ViewBag.Title
                    </h2>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                        <i class="fas fa-shield-alt me-1"></i> سامانه مودیان
                    </span>
                </div>
            </div>
        }

        <div class="content-card">
            @RenderBody()
            <div class="navigation-loader" id="navigationLoader">
                <div class="navigation-backdrop"></div>
                <div class="navigation-loader-content">
                    <div class="nav-spinner">
                        <div class="nav-ring"></div>
                        <div class="nav-ring"></div>
                        <div class="nav-ring"></div>
                    </div>
                    <div class="nav-text">لطفا صبر کنید...</div>
                </div>
            </div>
        </div>

        <footer class="dashboard-footer not-print m-0 mt-3">
            <div class="footer-content">
                <div class="footer-section">
                    <div class="footer-title">سامانه صدور فاکتور </div>
                    <p style="color: #718096; font-size: 0.9rem;">
                        ارائه خدمات صدور و مدیریت فاکتور الکترونیکی
                    </p>
                </div>

                <div class="footer-section">
                    <div class="footer-title">تماس با ما</div>
                    <div class="contact-item">
                        <i class="fas fa-mobile-alt"></i>
                        <span>09306830666</span>
                    </div>
                    <div class="contact-item">
                        <i class="fas fa-phone"></i>
                        <span>051-42631163</span>
                    </div>
                </div>

                <div class="footer-section">
                    <div class="footer-title">شبکه های اجتماعی</div>
                    <div class="social-icons">
                        <a href="https://t.me/+989354182557" target="_blank" class="telegram" title="تلگرام">
                            <i class="fab fa-telegram"></i>
                        </a>
                        <a href="https://wa.me/+989354182557" target="_blank" class="whatsapp" title="واتساپ">
                            <i class="fab fa-whatsapp"></i>
                        </a>
                        <a href="https://eitaa.com/+989354182557" target="_blank" class="eitaa" title="ایتا">
                            <img src="~/images/Eitaa_Icon.png" alt="Eitaa">
                        </a>
                        <a href="https://rubika.ir/AliHashemi2025" target="_blank" class="rubika" title="روبیکا">
                            <img src="~/images/Rubika_Icon.png" alt="Rubika">
                        </a>
                    </div>
                </div>
            </div>

            <div class="copyright">
                &copy; 2023 - Electronic Invoice - <a href="#">حریم خصوصی</a>
            </div>
        </footer>
    </div>

    <!-- Fintech Bottom Navigation Bar -->
    <nav class="fintech-bottom-nav not-print">
        <a href="/" class="fintech-nav-item @(reqPath == "" || reqPath == "/" || reqPath == "/index" ? "active" : "")">
            <div class="nav-icon-box">
                <i class="fas fa-home"></i>
            </div>
            <span>پیشخوان</span>
        </a>
        <a href="/InvoiceManage/Index" class="fintech-nav-item @(IsActive("/invoicemanage") ? "active" : "")">
            <div class="nav-icon-box">
                <i class="fas fa-file-invoice"></i>
            </div>
            <span>فاکتورها</span>
        </a>
        <a href="/Stuff/Index" class="fintech-nav-item @(IsActive("/stuff", "/admin/stuffs") ? "active" : "")">
            <div class="nav-icon-box">
                <i class="fas fa-boxes"></i>
            </div>
            <span>کالاها</span>
        </a>
        <a href="/Credit/Vallet" class="fintech-nav-item @(IsActive("/credit") ? "active" : "")">
            <div class="nav-icon-box">
                <i class="fas fa-wallet"></i>
            </div>
            <span>کیف پول</span>
        </a>
        <a href="/Account/UserProfile" class="fintech-nav-item @(IsActive("/account/userprofile", "/admin/users", "/account") ? "active" : "")">
            <div class="nav-icon-box">
                <i class="fas fa-user-cog"></i>
            </div>
            <span>مدیریت</span>
        </a>
    </nav>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/wordifyfa.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Change Profile Function
        function changeProfile(profileId) {
            if (profileId) {
                fetch('/api/profile/change', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ profileId: profileId })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            window.location.reload();
                        } else {
                            alert('خطا در تغییر پروفایل');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('خطا در ارتباط با سرور');
                    });
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // نمایش Badge برای نصب PWA
        if (window.matchMedia('(display-mode: standalone)').matches) {
            console.log('Running as PWA');
            // اضافه کردن badge
            const badge = document.createElement('span');
            badge.className = 'app-badge';
            badge.innerHTML = '<i class="fas fa-mobile-alt"></i> نسخه اپلیکیشن';
            document.querySelector('.page-title').appendChild(badge);
        }
    </script>
</body>

<!-- 2. لودینگ نیویگیشن (بین صفحات) -->

</html>