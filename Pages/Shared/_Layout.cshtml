    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/wordifyfa.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Change Profile Function
        var menuState = false;
        function changeProfile(profileId) {
            if (profileId) {
                // ارسال درخواست به سرور برای تغییر پروفایل
                fetch('/api/profile/change', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ profileId: profileId })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // رفرش صفحه برای اعمال تغییرات
                            window.location.reload();
                        } else {
                            alert('خطا در تغییر پروفایل');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('خطا در ارتباط با سرور');
                    });
            }
        }
        function setMenuState(menuState) {
            $.ajax({
                url: '/?handler=SetMenuState',
                type: 'GET',
                data: { menuState: menuState }
            });
        }
        function setLoaderRight() {
            var menuState = sidebar.classList.contains('sidebar-open');
            var navigation = document.getElementById("navigationLoader");
            if (menuState) navigation.style.right = "280px";
            else navigation.style.right = "80px";
            return menuState;
        }
        // Mobile menu toggle
        document.addEventListener('DOMContentLoaded', function () {
            const mobileMenuToggle = document.getElementById('mobileMenuToggle');
            const sidebar = document.getElementById('sidebar');
            const mobileMenuOverlay = document.getElementById('mobileMenuOverlay');
            if (window.innerWidth > 768) {
                menuState=setLoaderRight();
            }

            if (mobileMenuToggle) {
                mobileMenuToggle.addEventListener('click', function () {
                    if (window.innerWidth <= 768) {
                        sidebar.classList.toggle('mobile-open');
                        mobileMenuOverlay.classList.toggle('active');
                    }
                    else {
                        sidebar.classList.toggle('sidebar-open');
                        menuState=setLoaderRight();
                        setMenuState(menuState);
                    }
                });

                mobileMenuOverlay.addEventListener('click', function () {
                    sidebar.classList.remove('mobile-open');
                    mobileMenuOverlay.classList.remove('active');
                });

                // Accordion toggle for category menus
                const categoryToggles = document.querySelectorAll('.category-toggle');
                categoryToggles.forEach(toggle => {
                    toggle.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();

                        const dropdown = this.closest('.menu-dropdown');
                        if (!dropdown) return;

                        // If sidebar is collapsed on desktop, open it so submenu is visible
                        if (window.innerWidth > 768 && !sidebar.classList.contains('sidebar-open')) {
                            sidebar.classList.add('sidebar-open');
                            menuState = setLoaderRight();
                            setMenuState(true);
                        }

                        dropdown.classList.toggle('open');
                    });
                });

                // Close mobile menu only when clicking an actual navigation link (not category toggle)
                const navLinks = document.querySelectorAll('.menu-link:not(.category-toggle), .submenu-link');
                navLinks.forEach(link => {
                    link.addEventListener('click', function () {
                        if (window.innerWidth <= 768) {
                            sidebar.classList.remove('mobile-open');
                            mobileMenuOverlay.classList.remove('active');
                        }
                    });
                });

                const profileLink = document.querySelector('.user-profile');
                if (profileLink) {
                    profileLink.addEventListener('click', function () {
                        if (window.innerWidth > 768) {
                            if (menuState == false) {
                                sidebar.classList.toggle('sidebar-open');
                                menuState = setLoaderRight();
                                setMenuState(menuState);
                            }
                        }
                    });
                }
            }

            // Active menu item and parent dropdown synchronization
            const activeSub = document.querySelector('.submenu-link.active');
            if (activeSub) {
                const parentDropdown = activeSub.closest('.menu-dropdown');
                if (parentDropdown) parentDropdown.classList.add('open');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // نمایش Badge برای نصب PWA
        if (window.matchMedia('(display-mode: standalone)').matches) {
            console.log('Running as PWA');
            // اضافه کردن badge
            const badge = document.createElement('span');
            badge.className = 'app-badge';
            badge.innerHTML = '<i class="fas fa-mobile-alt"></i> نسخه اپلیکیشن';
            document.querySelector('.page-title').appendChild(badge);
        }
    </script>
</body>

