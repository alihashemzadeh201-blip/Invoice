@page
@model IndexModel
@inject Invoice.Code.ISelectedProfile profileService
@{
    ViewBag.Description = "این سامانه در راستای ارائه خدمات الکترونیکی مالیاتی ایجاد شده است. مودیان محترمی که موظف به ثبت اطلاعات فروش خود و صدور فاکتور الکترونیکی می باشند، می‌توانند  نسبت به صدور فاکتور و ارسال اطلاعات فروش خود ، از طریق این سامانه به سازمان امور مالیاتی اقدام کنند.";
    ViewBag.KeyWords = "صدور فاکتور الکترونیکی , سامانه مودیان , شناسه یکتای حافظه مالیاتی , کلید خصوصی , کلید عمومی , کارپوشه مودیان , اداره امورمالیاتی , مالیات , صدور فاکتور , ثبت فروش";
    ViewBag.Title = "پیشخوان سامانه مودیان";
}

<div class="text-center mt-4">
    @if (!User.Identity.IsAuthenticated)
    {
        @*<h1 class="strong text-danger h3">سامانه صدور صورت حساب الکترونیک</h1>*@
        <img src="/images/invoice.jpg" class="mw-100" />
        <p class="text-justify mt-5 text-column">
            این سامانه در راستای ارائه خدمات الکترونیکی مالیاتی ایجاد شده است. مودیان محترمی که موظف به ثبت اطلاعات فروش خود و صدور فاکتور الکترونیکی می باشند، می‌توانند  نسبت به صدور فاکتور و ارسال اطلاعات فروش خود ، از طریق این سامانه به سازمان امور مالیاتی اقدام کنند.
        </p>
        <div class="text-justify mt-3 text-column text-end">
            <p class='strong text-danger'>مراحل ارسال فاکتور</p>
            <ol>
                <li>
                    <span class="strong">اخذ کلید خصوصی و عمومی از مراکز میانی:</span> <br /> شما می توانید با مراجعه به یکی از سایت های تولید گواهی امضا مانند<a href="https://csr.orash.ir/" target="_blank">csr.orash.ir</a> نسبت به اخذ کلید خصوصی و عمومی اقدام نمایید.
                </li>
                <li>
                    <span class="strong">در خواست شناسه یکتا :</span> <br /> با مراجعه و ورود به سایت <a href="https://my.tax.gov.ir" target="_blank">کارپوشه سامانه مودیان مالیاتی</a> نسبت اخد شناسه یکتای حافظه مالیاتی اقدام نمایید. لازم به ذکر است که جهت درخواست شناسه یکتا ، کلید عمومی ضروری است.
                    <a class="mt-2 h5 d-block" target="_blank" href="/downloads/راهنمای پایانه فروشگاهی پیاده سازی شده-آبان 1401.pdf">راهنمای اخذ شناسه یکتا</a>
                </li>
                <li>
                    <span class="strong">ثبت کلید خصوصی و شناسه یکتا :</span> <br /> با مراجعه به <a href="/account/register">ناحیه کاربری</a> خود، کلید خصوص و شناسه یکتای اخذ شده را ثبت نمایید.
                </li>
                <li>
                    <span class="strong">صدور فاکتور :</span> <br /> قبل از صدور فاکتور ، لطفا ابتدا دستورالعمل صدورفاکتور الکترونیکی که از طرف سازمان امورمالیاتی منتشر شده است را با دقت مطالعه نمایید.
                    <a class="mt-2 d-block h5" target="_blank" href="/downloads/دستورالعمل صدور صورتحساب.pdf">دستورالعمل فنی صدور فاکتور الکترونیکی</a>
                </li>
            </ol>
        </div>
        <div class="mt-4">
            دوست عزیز ! اگر انجام مراحل بالا برای شما پیچیده است ، میتوانید این کار را به ما بسپارید.
            <div class="row">
                <div class="mt-3 col-md-3 m-auto">
                    <a class="btn btn-danger w-100" href="/request/requesttaxmemoryid">درخواست کلید خصوصی و شناسه یکتا</a>
                </div>
            </div>
        </div>
        <div class="mt-5 row">
            <div class="col-md-2"></div>
            <div class="col-md-4 mt-2">
                <a class="btn btn-info w-100 col-md-4" href="/account/login">ورود</a>
            </div>
            <div class="col-md-4 mt-2">
                <a class="btn btn-outline-info w-100 col-md-4" asp-page="/account/Register"> ثبت نام </a>
            </div>
            <div class="col-md-2"></div>
        </div>
    }
    else
    {
        <!-- داشبورد نئوبانک و خدمات مالی مودیان -->
        <div class="fintech-dashboard text-end mt-2">
            <!-- ۱. کارت بانکی دیجیتال مودی -->
            <div class="fintech-bank-card">
                <div class="fintech-card-header">
                    <div class="fintech-card-brand">
                        <i class="fas fa-shield-alt text-warning me-2"></i> کارت حساب سامانه مودیان
                    </div>
                    <div class="fintech-card-chip"></div>
                </div>

                <div class="fintech-card-balance-label">موجودی کیف پول و اعتبار فاکتور</div>
                <div class="fintech-card-balance">
                    @(Model.Vallet.HasValue ? Model.Vallet.Value.ToString("N0") : "0")
                    <span>ریال</span>
                </div>

                <div class="fintech-card-footer">
                    <div>
                        <div class="fintech-card-holder-label">صاحب پرونده / مودی</div>
                        <div class="fintech-card-holder-name">
                            @(profileService.Profile?.DisplayName ?? User.Identity.Name)
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/Credit/Vallet" class="fintech-copy-btn text-decoration-none">
                            <i class="fas fa-plus-circle me-1"></i> شارژ کیف پول
                        </a>
                        <a href="/Credit/CreditRequest" class="fintech-copy-btn text-decoration-none">
                            <i class="fas fa-history me-1"></i> تمدید اشتراک
                        </a>
                    </div>
                </div>
            </div>

            <!-- ۲. کاشی‌های شیشه‌ای دسترسی سریع (Glass Tiles Grid) -->
            <h5 class="glass-section-title">
                <i class="fas fa-th-large text-primary"></i> دسترسی سریع و عملیات بانکی
            </h5>
            <div class="glass-tile-grid">
                <a href="/InvoiceManage/CreateHeader" class="glass-tile tile-blue">
                    <div class="tile-icon">
                        <i class="fas fa-plus"></i>
                    </div>
                    <div class="tile-title">
                        <span>صدور فاکتور جدید</span>
                    </div>
                    <p class="tile-desc">ثبت و ارسال سریع فاکتور فروش الکترونیکی</p>
                </a>

                <a href="/InvoiceManage/Index" class="glass-tile tile-violet">
                    <div class="tile-icon">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </div>
                    <div class="tile-title">
                        <span>لیست فاکتورها</span>
                        @if (Model.TotalInvoices > 0)
                        {
                            <span class="tile-badge bg-primary text-white">@Model.TotalInvoices</span>
                        }
                    </div>
                    <p class="tile-desc">مشاهده وضعیت استعلام و سوابق ارسال</p>
                </a>

                <a href="/InvoiceManage/ImportGroupFactor" class="glass-tile tile-cyan">
                    <div class="tile-icon">
                        <i class="fas fa-file-excel"></i>
                    </div>
                    <div class="tile-title">
                        <span>ارسال گروهی (اکسل)</span>
                    </div>
                    <p class="tile-desc">بارگذاری و ثبت دسته‌ای فاکتورها با فایل اکسل</p>
                </a>

                <a href="/Stuff/Index" class="glass-tile tile-amber">
                    <div class="tile-icon">
                        <i class="fas fa-boxes"></i>
                    </div>
                    <div class="tile-title">
                        <span>کالا و خدمات</span>
                    </div>
                    <p class="tile-desc">مدیریت کدهای مالیاتی و کالاهای منتخب</p>
                </a>

                <a href="/Credit/Vallet" class="glass-tile tile-green">
                    <div class="tile-icon">
                        <i class="fas fa-wallet"></i>
                    </div>
                    <div class="tile-title">
                        <span>کیف پول و پرداخت</span>
                    </div>
                    <p class="tile-desc">ثبت فیش واریزی و مشاهده تراکنش‌های مالی</p>
                </a>

                <a href="/Account/UserProfile" class="glass-tile tile-dark">
                    <div class="tile-icon">
                        <i class="fas fa-id-card"></i>
                    </div>
                    <div class="tile-title">
                        <span>پروفایل و کلیدها</span>
                    </div>
                    <p class="tile-desc">تنظیم کلید خصوصی، شناسه حافظه و مشخصات مودی</p>
                </a>
            </div>

            <!-- ۳. کارت‌های آمار شیشه‌ای (Glass Stat Cards) -->
            <h5 class="glass-section-title mt-4">
                <i class="fas fa-chart-pie text-success"></i> آمار وضعیت ارسال فاکتورها
            </h5>
            <div class="glass-stat-grid">
                <div class="glass-stat-card">
                    <div class="glass-stat-header">
                        <span class="glass-stat-title">کل فاکتورها</span>
                        <div class="glass-stat-icon-wrap" style="background: linear-gradient(135deg, #3b82f6, #1d4ed8);">
                            <i class="fas fa-layer-group"></i>
                        </div>
                    </div>
                    <div class="glass-stat-val">@Model.TotalInvoices</div>
                </div>

                <div class="glass-stat-card">
                    <div class="glass-stat-header">
                        <span class="glass-stat-title">ارسال موفق</span>
                        <div class="glass-stat-icon-wrap" style="background: linear-gradient(135deg, #10b981, #059669);">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                    <div class="glass-stat-val text-success">@Model.SuccessInvoices</div>
                </div>

                <div class="glass-stat-card">
                    <div class="glass-stat-header">
                        <span class="glass-stat-title">دارای خطا</span>
                        <div class="glass-stat-icon-wrap" style="background: linear-gradient(135deg, #f43f5e, #e11d48);">
                            <i class="fas fa-times-circle"></i>
                        </div>
                    </div>
                    <div class="glass-stat-val text-danger">@Model.FailedInvoices</div>
                </div>

                <div class="glass-stat-card">
                    <div class="glass-stat-header">
                        <span class="glass-stat-title">در انتظار ارسال</span>
                        <div class="glass-stat-icon-wrap" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
                            <i class="fas fa-clock"></i>
                        </div>
                    </div>
                    <div class="glass-stat-val text-warning">@Model.PendingInvoices</div>
                </div>
            </div>

            <!-- ۴. نمودارهای وضعیت در پنل شیشه‌ای -->
            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="glass-card-surface h-100 mb-0">
                        <h6 class="text-center mb-3 fw-bold text-dark">
                            <i class="fas fa-chart-pie me-1 text-primary"></i> وضعیت ارسال فاکتورها
                        </h6>
                        <canvas id="statusChart"></canvas>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="glass-card-surface h-100 mb-0">
                        <h6 class="text-center mb-3 fw-bold text-dark">
                            <i class="fas fa-chart-pie me-1 text-info"></i> دسته‌بندی موضوعی فاکتورها
                        </h6>
                        <canvas id="topicChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var isAuth = '@User.Identity.IsAuthenticated'.toLowerCase() === 'true';
            if(!isAuth) return;

            // تنظیم فونت برای Chart.js
            Chart.defaults.font.family = 'Vazirmatn, Tahoma, sans-serif';

            // Chart 1: Status
            var ctxStatus = document.getElementById('statusChart').getContext('2d');
            new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: ['موفق', 'دارای خطا', 'در حال پردازش'],
                    datasets: [{
                        data: [@Model.SuccessInvoices, @Model.FailedInvoices, @Model.PendingInvoices],
                        backgroundColor: ['#28a745', '#dc3545', '#ffc107'],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });

            // Chart 2: Topic
            var ctxTopic = document.getElementById('topicChart').getContext('2d');
            var originalCount = @Model.TotalInvoices - @Model.CorrectiveInvoices - @Model.CancelledInvoices;
            if(originalCount < 0) originalCount = 0;

            new Chart(ctxTopic, {
                type: 'pie',
                data: {
                    labels: ['اصلی', 'اصلاحی', 'ابطالی'],
                    datasets: [{
                        data: [originalCount, @Model.CorrectiveInvoices, @Model.CancelledInvoices],
                        backgroundColor: ['#007bff', '#17a2b8', '#6c757d'],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        });
    </script>
}
